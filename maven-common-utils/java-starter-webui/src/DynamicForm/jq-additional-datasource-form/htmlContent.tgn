<head>
<script src="${contextPath!''}/webjars/1.0/common/passwordStrength.js"></script> 
        
</head>

<div class="container">
	<div class="topband">
		<#if (resultSetObject.additional_datasource_id)?? && (resultSetObject.additional_datasource_id)?has_content>
            <h2 class="title-cls-name float-left">${messageSource.getMessage('jws.editdatasource')}</h2>
        <#else>
            <h2 class="title-cls-name float-left">${messageSource.getMessage('jws.adddatasource')}</h2> 
        </#if>
 	</div>
  <form method="post" name="addEditForm" id="addEditForm">
    <div id="errorMessage" class="alert errorsms alert-danger alert-dismissable" style="display:none"></div>
    
    	<div class="row">
				<input type="hidden" data-type="varchar" id="additionalDatasourceId" name="additionalDatasourceId"  value="${(resultSetObject.additional_datasource_id)!""}">
				<input type="hidden" data-type="varchar" id="datasourceLookupId" name="datasourceLookupId"  value="${(resultSetObject.datasource_lookup_id)!""}" >
	    		<div class="col-4">
					<div class="col-inner-form full-form-fields">
					    <span class="asteriskmark">*</span>
						<label for="datasourcename"><@resourceBundle "jws.datasourceName" /></label>
						<input type="text" data-type="varchar" id="datasourcename" name="datasourcename" class="form-control" value="${(resultSetObject.datasource_name)!""}" >
					</div>
				</div>

	    		<div class="col-4">
					<div class="col-inner-form full-form-fields">
						<span class="asteriskmark">*</span>
						<label for="allDBDrivers"><@resourceBundle "jws.databaseProductName" /></label>
                        <a class="tipsicon tipslabelright collapsed" title="Tips" data-bs-toggle="collapse" href="#tipscolpase" role="button" aria-expanded="false">
                                        <i class="fa fa-solid fa-lightbulb" aria-hidden="true"></i>
                                    </a>
						<select class="form-control" id="allDBDrivers" onchange="onDBTypeChange()">
						</select>
					</div>
				</div>
	    		<#if (resultSetObject.additional_datasource_id)??>
	    		<div class="col-4">
                    <div class="col-inner-form full-form-fields datasrourceid">
					    <span class="asteriskmark">*</span>
						<label for="datasourceid">${messageSource.getMessage('jws.datasourceid')}</label>
						<input type="text" data-type="varchar" id="datasourceid" name="datasourceid" readonly disabled 
                            class="form-control" value="${(resultSetObject.additional_datasource_id)!""}" >
                        <span onclick="copyId()" class="copybtnc">
                            <i class="fa fa-regular fa-copy"></i>                        
                        </span>
					</div>
				</div>
                </#if>

                <div id="ftlParameterDiv" class="col-12">
                            <div class="collapse tipsdetailsblock" id="tipscolpase" style="margin-bottom :20px">
                                <div class="tipscontent"> 
                                    <h3 class="titlename method-sign-info">
                                    <label for="cs_jscript">Database Connection URL</label>   </h3>
                                     <span id="cs_jscript"><pre style="font-family: Verdana, sans-serif; width : 100%">
                                    <label style="font-style: italic; user-select: none;">	Create Datasource Connection URL for your Database Driver with suggested template :</label>
                                    <label id="connectionUrlPattern"></label>
                                     </pre>
                                </div>
                            </div>    
                     </div>
	    		
	    		<div class="col-12">
					<div class="col-inner-form full-form-fields">
						<span class="asteriskmark">*</span>
						<label for="connectionurl"><@resourceBundle "jws.connectionURL" /></label>
						<textarea class="form-control" rows="1" cols="10"  data-type="text"  id="connectionurl" placeholder="<@resourceBundle 'jws.connectionURL' />" name="dbconnectionurl" ></textarea>
					</div>
				</div>

                <div class="col-4">
					<div class="col-inner-form full-form-fields">
					    <span class="asteriskmark">*</span>
						<label for="username"><@resourceBundle "jws.username" /></label>
						<input type="text" data-type="varchar" id="username" name="username" class="form-control" autocomplete="false">
					</div>
				</div>

                <div class="col-4">
					<div class="col-inner-form full-form-fields passowrdblock">	
					    <span class="asteriskmark">*</span>
						<label for="password"><@resourceBundle "jws.password" /></label>
						<input type="password" data-type="varchar" id="password" name="password" class="form-control" autocomplete="false" >
					</div>
				</div>
    	</div>
        <div id="availableConnectionPropertiesDiv" class="col-12 method-sign-info-div" style="margin-bottom:15px;">
            <a class="tipsicon collapsed " data-bs-toggle="collapse" href="#tipscolpasemethod" role="button" aria-expanded="false">
                <i class="fa fa-solid fa-lightbulb" aria-hidden="true"></i>${messageSource.getMessage('jws.availableConnectionProperties')} 
        
            </a>
            <div id="availableConnectionPropertiesContainer">
                <div class="collapse" id="tipscolpasemethod">
                    <div class="tipscontent">
                        <div id="availableConnectionProperties">
                            
                        </div>
                    </div>
                </div>
            </div>          
		</div>	
        <div class="row margin-t-b">          
            <div class="col-6">
                <div class="col-inner-form full-form-fields">
                    <datalist id="connectionPropertyList"></datalist>
                    <table id="headerTable"  class="customtblecls">
                        <tr>
                            <th colspan="3">   
                                <div class="displyflx">                             
                                    <span class="titleclsnm">${messageSource.getMessage('jws.connectionProperties')} </span>                                    
                                </div>
                            </th>
                        </tr>    
                        <tr>
                            <td class="bgtd">${messageSource.getMessage('jws.propertyname')}</td>
                            <td class="bgtd">${messageSource.getMessage('jws.value')} </td>
                            <td class="bgtd"><span class="plusticon" onclick="addRow()"><i class="fa fa-plus-circle" aria-hidden="true"></i></span></td>
                        </tr>                                  
                    </table>
                </div>
            </div>
        </div>
        <div id="deleteHeader"></div>
         <div id="warningHeader"></div>	
  </form>
  
	<div class="row">
		<div class="col-12">
			<div class="text-end">
				<button type="button" id="testConnBtn" class="btn btn-primary" onclick="testDatabaseConnection()"><@resourceBundleWithDefault "jws.testConnection" "Test Connection" /></button>
				<div class="btn-group dropup custom-grp-btn">
                    <div id="savedAction">
                        <button type="button" id="saveAndReturn" class="btn btn-primary" onclick="typeOfActionWithIsEdit('${formId}', this, isEdit);">${messageSource.getMessage("jws.saveAndReturn")}</button>
                    </div>
                    <button id="actionDropdownBtn" type="button" class="btn btn-primary dropdown-toggle panel-collapsed" onclick="actionOptions();" data-bs-toggle="dropdown" aria-expanded="false"></button>
                    <div class="dropdown-menu action-cls"  id="actionDiv">
                    	<ul class="dropdownmenu">
                            <li id="saveAndCreateNew" onclick="typeOfActionWithIsEdit('${formId}', this, isEdit);">${messageSource.getMessage("jws.saveAndCreateNew")}</li>
                            <li id="saveAndEdit" onclick="typeOfActionWithIsEdit('${formId}', this, isEdit);">${messageSource.getMessage("jws.saveAndEdit")}</li>
                        </ul>
                    </div>  
                </div>
				<span onclick="backToPreviousPage();">
					<input id="backBtn" class="btn btn-secondary" name="backBtn" value="${messageSource.getMessage('jws.cancel')}" type="button">
				</span> 
			</div>
		</div>
	</div>
</div>
<textarea style="display:none;" id="txtTemp" >${(resultSetObject.datasource_configuration)!""}</textarea>
<script>
	document.title = "Manage Additional Datasource";
	let formId = "${formId}";
	//contextPath = "${contextPath}";
	 let isEdit = 0;
     let driverList;
     let availableConnectionProperties = [];
     let rowCounter = 0;
     let savedDatasourceProperties = {};
     const RESERVED_PROPERTIES = ["url","username","password"];
     const PROPERTY_KEY_REGEX = /^[A-Za-z][A-Za-z0-9._$-]*$/;
  $(function(){

      <#if (resultSet)??>
      	<#list resultSet as resultSetList>
          let connectionDetails =  JSON.parse($('#txtTemp').val());;
          $("#connectionurl").text(connectionDetails.url);
          $("#username").val(connectionDetails.userName);
          $("#password").val(connectionDetails.password); 
          $("#allDBDrivers").attr("disabled", true);  
      	</#list>
      </#if>
    
      <#if (resultSet)?? && resultSet?has_content>
      	isEdit = 1;
        $("#password").keydown();
      </#if>
    
	savedAction(formId, isEdit);
	hideShowActionButtons();
    let jsonStr = '${(resultSetObject.datasource_properties)!""}';

    if (jsonStr) {
        savedDatasourceProperties = JSON.parse(jsonStr);
    }
    getDBDrivers();
    
  });

    $('#password').passtrength({
          minChars: 6,
          passwordToggle: true,
          tooltip: true,
          eyeImg: "${contextPath}/webjars/1.0/images/eyeImage.svg"
        });
    let driverUrl = new Object();

	function getDBDrivers(){
        let dbTypeId = $("#datasourceLookupId").val().trim();
        $.ajax({
		    type : "POST",
		    url : contextPath+apiPath+"/jq-db-driver-list",
            success : function(data) {
                driverList = data;
                for (let property in data) {
                	if(data[property].driverClassAvailable === true){
    					$("#allDBDrivers").append("<option value="+property+">"+data[property].databaseDisplayProductName+"</option>")
                        driverUrl[property] = data[property].connectionUrlPattern;
    				}
				}
				if(dbTypeId !== ""){ 
					$("#allDBDrivers").val(dbTypeId);
                    $("#connectionUrlPattern").text(driverUrl[dbTypeId]);
				}else{
					$("#datasourceLookupId").val($("#allDBDrivers option:first").val());
                    $("#connectionUrlPattern").text(driverUrl[$("#datasourceLookupId").val()]);
				}
                  // Load URL pattern and connection properties
                    onDBTypeChange();
		    },
	        error : function(xhr, error){
		        showMessage("Error occurred while fetching list of available database drivers", "error");
	        },
		});
    }
    

	function copyId(){
        let input = $("<input>");
        $("body").append(input);
        input.val($("#datasourceid").val()).select();
        document.execCommand("copy");
        input.remove();
        showMessage("Id copied successfully", "success");
	}
  
  function showHidePassword(thisObj){
        var element = $(thisObj).parent().find("input[name='password']");
        if (element.prop("type") === "password") {
            element.prop("type","text");
            $(thisObj).find("i").removeClass("fa-eye");
            $(thisObj).find("i").addClass("fa-eye-slash");
            $("#password").focus();
        } else {
            element.prop("type","password");
            $(thisObj).find("i").removeClass("fa-eye-slash");
            $(thisObj).find("i").addClass("fa-eye");
            $("#password").focus();
        }
    }
    
	function onDBTypeChange(){ 
		let datasourceLookupId = $("#allDBDrivers").find(":selected").val();
        let properties = [];

		$("#datasourceLookupId").val(datasourceLookupId);

         // Set connection URL placeholder
        let connectionUrlPattern = driverUrl[datasourceLookupId] || "";

        $("#connectionurl")
            .attr("placeholder", connectionUrlPattern);

        // If you still display the pattern elsewhere, keep this
        $("#connectionUrlPattern").text(driverUrl[datasourceLookupId]);
        

        if(driverList[datasourceLookupId].connectionProperties){
                properties = JSON.parse(driverList[datasourceLookupId].connectionProperties);
            }

        loadConnectionProperties(properties);

        // Populate saved properties only once
        if (Object.keys(savedDatasourceProperties).length > 0
                && $("#headerTable tr").length == 2) {

            $.each(savedDatasourceProperties, function(key, value) {
                addRow(key, value);
            });
        }

        refreshPropertyList();     
             
	}
	
	function saveData(forceSave = false){
        let isDataSaved = false;
		let formData = validateData();
        let connectionUrl = $("#connectionurl").val().trim();
        let selectedDBType = $("#allDBDrivers").find(":selected").val();
        let dbName = $("#allDBDrivers").find(":selected").text();
        if(driverList[selectedDBType].driverClassAvailable === false){ 
       		showMessage("No driver class found for: " + dbName , "error");
        	return false;
        }
        if(connectionUrl.includes(driverList[selectedDBType].datasourceName) === false){
            $("#connectionurl").focus();
            $("#connectionurl").closest("div").parent().effect("highlight", {}, 3000);
        	showMessage("Invalid connection url", "warn");
        	return false;
        }
        if(formData === undefined){
			showMessage("All fields are mandatory", "warn");
            $("#addEditForm div.row").effect("highlight", {}, 3000);
			return false;
		}
        let additionalDatasourceId = $("#additionalDatasourceId").val().trim();
        let datasourceLookupId = $("#datasourceLookupId").val().trim();
        let userName = $("#username").val().trim();
        let password = $("#password").val().trim();
        let dataSourceName = $("#datasourcename").val().trim();

        let datasourceProperties;
        try{
            datasourceProperties = getDatasourceProperties();
        }catch(ex){
            showMessage(ex, "warn");
            return false;
        }
       
         $.ajax({
		    type : "POST",
		    async:false,
		    url : contextPath+apiPath+"/jq-db-datasource",
            data:{
                adi: additionalDatasourceId,
                dn: dataSourceName,
                dli: datasourceLookupId,
                curl: connectionUrl,
                un: userName,
                pwd: password,
                dsp: datasourceProperties,
                f: forceSave
            },    
        success: function(response) {
              /* if (response.message== "Success") {
                    isDataSaved = true;
                    showMessage("Datasource saved successfully", "success");
                } else {
                    showMessage(response.message, "error");
                }*/
                switch(response.status){

                    case "SUCCESS":
                        isDataSaved = true;
                        showMessage(response.message,"success");
                        return;

                    case "WARNING":
                        setTimeout(function () {
                            showWarningDialog(response.message+ "<br/><br/> Do you want to continue ?");
                        }, 0);
                        return;

                    case "ERROR":
                        showMessage(response.message,"error");
                        return;

                    default:
                        showMessage("Unexpected response.","error");
                }


                },

        error: function(xhr) {

            let response = xhr.responseJSON;

            if (response && response.message) {
                showMessage(response.message, "error");
            } else {
                showMessage("Could not connect to the database.", "error");
            }
        }
	        
		});
		return  isDataSaved; 
    }
	

    function validateData(){
		let serializedForm = $("#addEditForm").serializeArray();
		for(let iCounter =0, length = serializedForm.length;iCounter<length;iCounter++){
			let fieldValue = $.trim(serializedForm[iCounter].value);
			let fieldName = $.trim(serializedForm[iCounter].name);
			let isFieldVisible = $("#"+fieldName).is(":visible");
            if(fieldValue !== ""){
            	serializedForm[iCounter].value = fieldValue;
            }else if(isFieldVisible === true){
            	return undefined;
            }  
		}
		serializedForm = serializedForm.formatSerializedArray();
		return serializedForm;
    }
    
	function testDatabaseConnection(force){
        force = force || false;
        let datasourceLookupId = $("#datasourceLookupId").val().trim();
        let connectionUrl = $("#connectionurl").val().trim();
        let userName = $("#username").val().trim();
        let password = $("#password").val().trim();
        let selectedDBType = $("#allDBDrivers").find(":selected").val();

        if(connectionUrl.includes(driverList[selectedDBType].datasourceName) === false){
            $("#connectionurl").focus();
            $("#connectionurl").closest("div").parent().effect("highlight", {}, 3000);
        	showMessage("Invalid connection url", "warn");
        	return false;
        }

        if(userName.length < 1){
            $("#username").focus();
            $("#username").closest("div").parent().effect("highlight", {}, 3000);
        	showMessage("Username is mandatory", "warn");
        	return false;
        }

         if(password.length < 1){
            $("#password").focus();
            $("#password").closest("div").parent().effect("highlight", {}, 3000);
        	showMessage("Password is mandatory", "warn");
        	return false;
        }

        let datasourceProperties;
        try{
            datasourceProperties = getDatasourceProperties();
        }catch(ex){
            showMessage(ex, "warn");
            return false;
        }
        $.ajax({
            type: "POST",
            async: true,
            url: contextPath + apiPath + "/jq-test-database-connection",
            data: {
                dli: datasourceLookupId,
                curl: connectionUrl,
                un: userName,
                pwd: password,
                dsp: datasourceProperties,
                f: force
            },
        complete: function(xhr) {

                var response = xhr.responseJSON;

                if (!response) {
                    response = JSON.parse(xhr.responseText);
                }

                if (response.status === "SUCCESS") {

                    showMessage(response.message, "success");

                } else if (response.status === "WARNING") {

                        showWarningDialog(response.message + "<br/><br/>Do you want to continue testing the connection?", function () {
                                testDatabaseConnection(true);
                            });

                } else {

                    showMessage(response.message, "error");
                }
            }
        });
    }
    
	function backToPreviousPage() {
		location.href = contextPath+"/cf/ad";
	}
    
    function addRow(key, value){
		let context = this;	
        let rowId = "row_" + (++rowCounter);
		let row = '<tr id='+rowId +'><td><input class="key form-control" list="connectionPropertyList" autocomplete="off" onchange="validatePropertyKey(this)"></td><td><input class="value" type="text" onchange="validatePropertyValue(this)"></td><td>';		 
		row +=
            '<span id="btn_' + rowId + '" onclick="deleteRow(this)" class="cusrorhandcls">' +
            '<i class="fa fa-minus-circle"></i>' +
            '</span>';
        row+='</td></tr>';
		
		$('#headerTable tr:last').after(row);
		if(key !== undefined && value !== undefined){
				$('#headerTable tr:last').find('td input.key').val(key);
				$('#headerTable tr:last').find('td input.value').val(value);
			
		}
	}
    
    function deleteRow(rowElement){
		$("#deleteHeader").html("Are you sure you want to delete?");
		$("#deleteHeader").dialog({
		bgiframe	: true,
		autoOpen	: true, 
		modal		: true,
		closeOnEscape : true,
		draggable	: true,
		resizable	: false,
		title		: "Delete",
		position: {
			my: "center", at: "center"
		},
		buttons : [
		{
				text   : "${messageSource.getMessage('jws.deleteBtnText')}",
				"class": 'btn btn-primary',
				click	: function(){
					$(this).dialog('close');
					let rowId = $(rowElement).attr('id').replace("btn_", "");
					$('#'+rowId).remove();
                    refreshPropertyList();
				}
         },
		
		{
				text	:"${messageSource.getMessage('jws.cancel')}",
				"class" : 'btn btn-secondary',
				click	: function() { 
					$(this).dialog('close');
				},
		}
			
       ],	
	   open: function( event, ui ) {
			 $('.ui-dialog-titlebar')
		   	    .find('button').removeClass('ui-dialog-titlebar-close').addClass('ui-button ui-corner-all ui-widget ui-button-icon-only ui-dialog-titlebar-close')
		       .prepend('<span class="ui-button-icon ui-icon ui-icon-closethick"></span>').append('<span class="ui-button-icon-space"></span>');
       		}	
	   });	
	}
	
    function loadConnectionProperties(properties){
         if (!Array.isArray(properties)) {
            properties = [];
        }
        availableConnectionProperties = properties;
        $("#connectionPropertyList").empty();
        properties.forEach(function(item){
            $("#connectionPropertyList").append(
                "<option value='"+item.key+"'>"
            );
        });
        renderConnectionPropertyHelp();
    }

    function refreshPropertyList() {
        $("#connectionPropertyList").empty();
        let selectedKeys = [];
        $(".key").each(function () {
            let key = $(this).val().trim();
            if (key) {
                selectedKeys.push(key);
            }
        });
        availableConnectionProperties.forEach(function (property) {
            if (!selectedKeys.includes(property.key)) {

                $("#connectionPropertyList").append(
                    "<option value='" + property.key + "'></option>"
                );

            }
        });
    }

    function getDatasourceProperties() {
        let datasourceProperties = {};
        let duplicateKeys = [];
        $("#headerTable tr").each(function () {
            let keyInput = $(this).find(".key");
            let valueInput = $(this).find(".value");
            // Ignore header rows
            if (keyInput.length === 0) {
                return;
            }
            let key = $.trim(keyInput.val());
            let value = $.trim(valueInput.val());
            

            // An added row cannot be left empty
            if (key === "" && value === "") {
                keyInput.focus();
                throw "Property Name and Value are required, or remove the empty row.";
            }

            // Key is mandatory if value is entered
            if (key === "") {
                keyInput.focus();
                throw "Connection Property is mandatory.";
            }
            // Value is mandatory if key is entered
            if (value === "") {
                valueInput.focus();
                throw "Value is mandatory for property '" + key + "'.";
            }

            if (!PROPERTY_KEY_REGEX.test(key)) {
                keyInput.focus();
                throw "Invalid property name '" + key + "'.";
            }

            if (RESERVED_PROPERTIES.includes(key.toLowerCase())) {
                keyInput.focus();
                throw "'" + key + "' is a reserved datasource property.";
            }
            // Duplicate validation
            let normalizedKey = key.toLowerCase();

            if (duplicateKeys.includes(normalizedKey)) {
                keyInput.focus();
                throw "Duplicate property '" + key + "' found.";
            }

            duplicateKeys.push(normalizedKey);
            datasourceProperties[key] = value;
        });
        return JSON.stringify(datasourceProperties);
    }
 function renderConnectionPropertyHelp() {

    if (!Array.isArray(availableConnectionProperties)
            || availableConnectionProperties.length === 0) {
          $("#availableConnectionProperties").html(
            "<div class='text-muted p-2'>No database properties available.</div>"
        );
        return;
    }

     let html = "";
    html += "<table class='table table-bordered table-sm'>";
    html += "<thead>";
    html += "<tr>";
    html += "<th>Property</th>";
    html += "<th>Default</th>";
    html += "<th>Description</th>";
    html += "</tr>";
    html += "</thead>";
    html += "<tbody>";

    availableConnectionProperties.forEach(function(property) {

        html += "<tr>";
        html += "<td>" + property.key + "</td>";
        html += "<td>" + (property.defaultValue || "-") + "</td>";
        html += "<td>" + (property.description || "-") + "</td>";
        html += "</tr>";

    });

    html += "</tbody>";
    html += "</table>";

    $("#availableConnectionProperties").html(html);
}

    function validatePropertyKey(input) {

        let key = $.trim($(input).val());

        $(input).val(key);
        if (key === "") {
            $(input).closest("tr").find(".value").val("");
            refreshPropertyList();
            return;
        }
        if (key.length > 100) {
            showMessage("Property name cannot exceed 100 characters.", "warn");
            $(input).val("");
            $(input).focus();
            return;
        }

        // Reserved property
        if (RESERVED_PROPERTIES.includes(key.toLowerCase())) {
            showMessage("'" + key + "' is a reserved datasource property.", "warn");
            $(input).val("");
            $(input).focus();
            refreshPropertyList();
            return;
        }
        if (!PROPERTY_KEY_REGEX.test(key)) {

            showMessage(
                "Property name can contain only letters, numbers, '.', '_' and '-'. It must start with a letter.",
                "warn"
            );
            $(input).val("");
            $(input).focus();
            return;
        }
        // Duplicate
        let duplicate = false;

        $(".key").not(input).each(function () {

            if ($.trim($(this).val()).toLowerCase() === key.toLowerCase()) {
                duplicate = true;
                return false;
            }

        });

        if (duplicate) {
            showMessage("Property '" + key + "' already exists.", "warn");
            $(input).val("");
            $(input).focus();
            refreshPropertyList();
            return;
        }

        // Populate default value
        let property = availableConnectionProperties.find(function(p) {
             return p.key.toLowerCase() === key.toLowerCase();
        });

        if (property) {
                $(input)
                    .closest("tr")
                    .find(".value")
                    .val(property.defaultValue || "");
            }

        refreshPropertyList();
    }

        function validatePropertyValue(input) {

            let value = $.trim($(input).val());
            $(input).val(value);

            if (value.length > 1000) {
                showMessage("Property value cannot exceed 1000 characters.", "warn");
                $(input).focus();
                return;
            }

            if (value === "") {
                showMessage("Property value cannot be blank.", "warn");
                $(input).focus();
                return;
            }
        }

       function showWarningDialog(message, yesCallback) {

                $("#warningHeader").html(message);

                $("#warningHeader").dialog({
                    bgiframe: true,
                    autoOpen: true,
                    modal: true,
                    closeOnEscape: true,
                    draggable: true,
                    resizable: false,
                    title: "Warning",
                    position: {
                        my: "center",
                        at: "center"
                    },
                    buttons: [
                    {
                        text: "Yes",
                        class: "btn btn-primary",
                        click: function () {
                            $(this).dialog("close");

                            if (typeof yesCallback === "function") {
                                yesCallback();
                            }
                        }
                    },
                    {
                        text: "No",
                        class: "btn btn-secondary",
                        click: function () {
                            $(this).dialog("close");
                        }
                    }],
                    open: function () {
                        $('.ui-dialog-titlebar')
                            .find('button')
                            .removeClass('ui-dialog-titlebar-close')
                            .addClass('ui-button ui-corner-all ui-widget ui-button-icon-only ui-dialog-titlebar-close')
                            .prepend('<span class="ui-button-icon ui-icon ui-icon-closethick"></span>')
                            .append('<span class="ui-button-icon-space"></span>');
                    }
                });
            }
</script>