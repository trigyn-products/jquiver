         function saveTaskProperty(
         element,
         propertyName,
         value
         ) {
         
         const moddle =
             window.modeler.get(
                 "moddle"
             );
         
         const modeling =
             window.modeler.get(
                 "modeling"
             );
         
         const taskConfig =
             getOrCreateTaskConfig(
                 element,
                 moddle,
                 modeling
             );
         
         taskConfig[propertyName] =
             value;
         
         modeling.updateProperties(
             element,
             {}
         );
         
         console.log(
             propertyName +
             " Saved:",
             value
         );
         }
         
         function getVariables(
         element
         ) {
         
         const businessObject =
             element.businessObject;
         
         const extensionElements =
             businessObject.extensionElements;
         
         if (
             !extensionElements
         ) {
             return [];
         }
         
         return extensionElements.values.filter(
             function(v) {
         
                 return (
                     v.$type ===
                     "jq:Variable"
                 );
             }
         );
         }
         function addVariable(
         element
         ) {
         console.log("ADD VARIABLE CALLED");
         
         const moddle =
             modeler.get(
                 "moddle"
             );
         
         const modeling =
             modeler.get(
                 "modeling"
             );
         
         const businessObject =
             element.businessObject;
         
         let extensionElements =
             businessObject.extensionElements;
         
         if (
             !extensionElements
         ) {
         
             extensionElements =
                 moddle.create(
                     "bpmn:ExtensionElements",
                     {
                         values: []
                     }
                 );
         
             modeling.updateProperties(
                 element,
                 {
                     extensionElements:
                         extensionElements
                 }
             );
         }
         
         const variable =
             moddle.create(
                 "jq:Variable",
                 {
                     name:
                         "",
                     type:
                         "String"
                 }
             );
         
         extensionElements.values.push(
             variable
         );
         
         modeling.updateProperties(
             element,
             {}
         );
         }
         function renderVariables(
         element
         ) {
         
         const container =
             document.getElementById(
                 "variableContainer"
             );
         
         container.innerHTML =
             "";
         
         const variables =
             getVariables(
                 element
             );
         
         variables.forEach(function(v,index) {
         
         container.innerHTML +=
         
             '<div class="jq-variable">' +
         
                 '<input ' +
                 'type="text" ' +
                 'class="varName" ' +
                 'data-index="' + index + '" ' +
                 'value="' + (v.name || '') + '">' +
         
                 '<select ' +
                 'class="varType" ' +
                 'data-index="' + index + '">' +
         
                     '<option value="String"' +
                     (v.type === "String" ? " selected" : "") +
                     '>String</option>' +
         
                     '<option value="Integer"' +
                     (v.type === "Integer" ? " selected" : "") +
                     '>Integer</option>' +
         
                     '<option value="Boolean"' +
                     (v.type === "Boolean" ? " selected" : "") +
                     '>Boolean</option>' +
         
                     '<option value="Date"' +
                     (v.type === "Date" ? " selected" : "") +
                     '>Date</option>' +
         
                 '</select>' +
         
                 '<button ' +
                 'class="deleteVariable" ' +
                 'data-index="' + index + '">' +
                 'Delete' +
                 '</button>' +
         
             '</div>';
         });
         
         const inputs =
         document.querySelectorAll(
             ".varName"
         );
         
         const lastInput =
         inputs[inputs.length - 1];
         
         if (lastInput) {
         
         lastInput.focus();
         }
         
         bindVariableEvents(
         element
         );
         
         }
         
         function bindVariableEvents(
         element
         ) {
         
         document
         .querySelectorAll(
             ".varName"
         )
         .forEach(function(input) {
         
             input.addEventListener(
                 "change",
                 function() {
         
                     updateVariable(
                         element,
                         this.dataset.index,
                         "name",
                         this.value
                     );
                 }
             );
         });
         
         document
         .querySelectorAll(
             ".varType"
         )
         .forEach(function(select) {
         
             select.addEventListener(
                 "change",
                 function() {
         
                     updateVariable(
                         element,
                         this.dataset.index,
                         "type",
                         this.value
                     );
                 }
             );
         });
         
         document
         .querySelectorAll(
             ".deleteVariable"
         )
         .forEach(function(button) {
         
             button.addEventListener(
                 "click",
                 function() {
         
                     deleteVariable(
                         element,
                         this.dataset.index
                     );
                 }
             );
         });
         }
         
         function updateVariable(
         element,
         index,
         property,
         value
         ) {
         
         const variables =
             getVariables(
                 element
             );
         
               if (
             !variables[index]
         ) {
             return;
         }
         
         variables[index][property] =
             value;
         
         modeler
         .get("modeling")
         .updateProperties(
             element,
             {}
         );
         }
         
         function deleteVariable(
         element,
         index
         ) {
         
         const extensionElements =
             element.businessObject
                 .extensionElements;
         
         if (
             !extensionElements
         ) {
             return;
         }
         
         const variables =
             getVariables(
                 element
             );
         
         const variable =
             variables[index];
         
         extensionElements.values =
             extensionElements.values.filter(
                 function(v) {
         
                     return v !== variable;
                 }
             );
         
         modeler
             .get("modeling")
             .updateProperties(
                 element,
                 {}
             );
         
         renderVariables(
             element
         );
         }
         
