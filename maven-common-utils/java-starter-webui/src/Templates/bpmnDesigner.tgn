         function getSla(
         element
         ) {
         
         const businessObject =
             element.businessObject;
         
         const extensionElements =
             businessObject.extensionElements;
         
         if (
             !extensionElements
         ) {
             return null;
         }
         
         return extensionElements.values.find(
             function(v) {
         
                 return (
                     v.$type ===
                     "jq:Sla"
                 );
             }
         );
         }
         function getOrCreateSla(
         element,
         moddle,
         modeling
         ) {
         
         const businessObject =
             element.businessObject;
         
         let extensionElements =
             businessObject.extensionElements;
         
         if (
             !extensionElements
         ) {
         
             extensionElements =
                 moddle.create(
                     "bpmn:ExtensionElements",
                     {
                         values: []
                     }
                 );
         
             modeling.updateProperties(
                 element,
                 {
                     extensionElements:
                         extensionElements
                 }
             );
         }
         
         let sla =
             extensionElements.values.find(
                 function(v) {
         
                     return (
                         v.$type ===
                         "jq:Sla"
                     );
                 }
             );
         
         if (!sla) {
         
             sla =
                 moddle.create(
                     "jq:Sla",
                     {}
                 );
         
             extensionElements.values.push(
                 sla
             );
         }
         
         return sla;
         }
         function saveSlaProperty(
         element,
         propertyName,
         value
         ) {
         
         const moddle =
             modeler.get(
                 "moddle"
             );
         
         const modeling =
             modeler.get(
                 "modeling"
             );
         
         const sla =
             getOrCreateSla(
                 element,
                 moddle,
                 modeling
             );
         
         sla[propertyName] =
             value;
         
         modeling.updateProperties(
             element,
             {}
         );
         
         console.log(
             propertyName +
             " Saved:",
             value
         );
         }
         
         function getEscalations(
         element
         ) {
         
         const businessObject =
             element.businessObject;
         
         const extensionElements =
             businessObject.extensionElements;
         
         if (
             !extensionElements
         ) {
             return [];
         }
         
         return extensionElements.values.filter(
             function(v) {
         
                 return (
                     v.$type ===
                     "jq:Escalation"
                 );
             }
         );
         }
         
         function addEscalation(
         element
         ) {
         
         const moddle =
             modeler.get(
                 "moddle"
             );
         
         const extensionElements =
             getOrCreateExtensionElements(
                 element,
                 moddle
             );
         
         const escalation =
             moddle.create(
                 "jq:Escalation",
                 {
                     level: "1",
                     afterHours: "24",
                     role: "",
                     action: "EMAIL"
                 }
             );
         
         extensionElements.values.push(
             escalation
         );
         
         modeler
         .get("modeling")
         .updateProperties(
             element,
             {}
         );
         }
         
         function renderEscalations(
         element
         ) {
         
         const container =
             document.getElementById(
                 "escalationContainer"
             );
         
         container.innerHTML = "";
         
         const escalations =
             getEscalations(
                 element
             );
         
         escalations.forEach(
         
             function(
                 esc,
                 index
             ) {
         
                 container.innerHTML +=
         
                 '<div class="jq-escalation">' +
         
                     '<input ' +
                     'class="escLevel" ' +
                     'data-index="' +
                     index +
                     '" ' +
                     'value="' +
                     (esc.level || "") +
                     '">' +
         
                     '<input ' +
                     'class="escAfterHours" ' +
                     'data-index="' +
                     index +
                     '" ' +
                     'value="' +
                     (esc.afterHours || "") +
                     '">' +
         
                     '<input ' +
                     'class="escRole" ' +
                     'data-index="' +
                     index +
                     '" ' +
                     'value="' +
                     (esc.role || "") +
                     '">' +
         
                     '<select ' +
                     'class="escAction" ' +
                     'data-index="' +
                     index +
                     '">' +
         
                         '<option value="EMAIL"' +
                         (esc.action === "EMAIL"
                             ? " selected"
                             : "") +
                         '>EMAIL</option>' +
         
                         '<option value="REASSIGN"' +
                         (esc.action === "REASSIGN"
                             ? " selected"
                             : "") +
                         '>REASSIGN</option>' +
         
                         '<option value="AUTO_APPROVE"' +
                         (esc.action === "AUTO_APPROVE"
                             ? " selected"
                             : "") +
                         '>AUTO_APPROVE</option>' +
         
                     '</select>' +
         
                     '<button ' +
                     'class="deleteEscalation" ' +
                     'data-index="' +
                     index +
                     '">' +
                     'Delete' +
                     '</button>' +
         
                 '</div>';
             }
         );
         
         bindEscalationEvents(
             element
         );
         }
         
         function bindEscalationEvents(
         element
         ) {
         
         document
         .querySelectorAll(
             ".escLevel"
         )
         .forEach(
         
             function(
