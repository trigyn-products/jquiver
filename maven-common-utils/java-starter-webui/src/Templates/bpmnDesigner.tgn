         function renderGatewayProperties(
         element
         ) {
         const elementName =
         element.businessObject.name || "";
         
         const outgoingFlows =
         element.businessObject.outgoing || [];
         
         const container =
             document.getElementById(
                 "jqFormContainer"
             );
         
             const currentDefault =
         
         element.businessObject.default
             ? element.businessObject.default.id
             : "";
         
             let flowOptions =
         
         '<option value="">None</option>';
         
         outgoingFlows.forEach(function(flow) {
         
         flowOptions +=
         
             '<option value="' +
         
             flow.id +
         
              '"' +
         
         (currentDefault === flow.id
             ? ' selected'
             : '') +
         
         '>' +
         
             flow.id +
         
             '</option>';
         });
         
         container.innerHTML =
         '<div class="jq-field">' +
         
         '<label>Element Name</label>' +
         
         '<input type="text" ' +
         
         'id="elementName" ' +
         
         'value="' +
         
         elementName +
         
         '">' +
         
         '</div>' +
             '<h3>Gateway Configuration</h3>' +
         
             '<div class="jq-field">' +
         
                 '<label>Gateway Type</label>' +
         
                 '<input type="text" readonly value="' +
         
                 element.type +
         
                 '">' +
         
             '</div>'+
             '<div class="jq-field">' +
         
         '<label>Default Flow</label>' +
         
         '<select id="defaultFlow">' +
         
             flowOptions +
         
         '</select>' +
         
         '</div>';
         
         document
         .getElementById("elementName")
         .addEventListener(
             "change",
             function(e) {
         
                 saveElementName(
                     element,
                     e.target.value
                 );
             }
         );
         
         document
         .getElementById(
         "defaultFlow"
         )
         .addEventListener(
         
         "change",
         
         function(e) {
         
             saveDefaultFlow(
         
                 element,
         
                 e.target.value
             );
         }
         );
         bindElementName(
         element
         );
         }
         
         function saveElementName(
         element,
         value
         ) {
         
         const modeling =
             modeler.get(
                 "modeling"
             );
         
         modeling.updateProperties(
             element,
             {
                 name: value
             }
         );
         
         console.log(
             "Element Name Saved:",
             value
         );
         }
         
         
         
         function saveDefaultFlow(
         element,
         flowId
         ) {
         
         const modeling =
             modeler.get(
                 "modeling"
             );
         
         const outgoingFlows =
             element.businessObject.outgoing || [];
         
         const selectedFlow =
             outgoingFlows.find(
                 function(f) {
         
                     return f.id === flowId;
                 }
             );
         
         modeling.updateProperties(
         
             element,
         
             {
                 default:
                     selectedFlow || null
             }
         );
         }
         
         function getOrCreateCondition(
