         function renderProcessVariables(
         processElement
         ) {
         
         const container =
             document.getElementById(
                 "processVariableContainer"
             );
         
         container.innerHTML =
             "";
         
         const variables =
             getProcessVariables(
                 processElement
             );
         
         variables.forEach(
             function(v,index) {
         
                 container.innerHTML +=
         
                     '<div class="jq-variable">' +
         
                         '<input ' +
                         'type="text" ' +
                         'class="processVarName" ' +
                         'data-index="' +
                         index +
                         '" ' +
                         'value="' +
                         (v.name || "") +
                         '">' +
         
                         '<select ' +
                         'class="processVarType" ' +
                         'data-index="' +
                         index +
                         '">' +
         
                             '<option value="String"' +
                             (v.type === "String"
                                 ? " selected"
                                 : "") +
                             '>String</option>' +
         
                             '<option value="Integer"' +
                             (v.type === "Integer"
                                 ? " selected"
                                 : "") +
                             '>Integer</option>' +
         
                             '<option value="Boolean"' +
                             (v.type === "Boolean"
                                 ? " selected"
                                 : "") +
                             '>Boolean</option>' +
         
                             '<option value="Date"' +
                             (v.type === "Date"
                                 ? " selected"
                                 : "") +
                             '>Date</option>' +
         
                         '</select>' +
         
                         '<button ' +
                         'class="deleteProcessVariable" ' +
                         'data-index="' +
                         index +
                         '">' +
                         'Delete' +
                         '</button>' +
         
                     '</div>';
             }
         );
         
         bindProcessVariableEvents(
             processElement
         );
         
         const inputs =
             document.querySelectorAll(
                 ".processVarName"
             );
         
         const lastInput =
             inputs[
                 inputs.length - 1
             ];
         
         if (
             lastInput
         ) {
         
             lastInput.focus();
         }
         }
         function bindProcessVariableEvents(
         processElement
         ) {
         
         document
         .querySelectorAll(
             ".processVarName"
         )
         .forEach(function(input) {
         
             input.addEventListener(
                 "change",
                 function() {
         
                     updateProcessVariable(
                         processElement,
                         this.dataset.index,
                         "name",
                         this.value
                     );
                 }
             );
         });
         
         document
         .querySelectorAll(
             ".processVarType"
         )
         .forEach(function(select) {
         
             select.addEventListener(
                 "change",
                 function() {
         
                     updateProcessVariable(
                         processElement,
                         this.dataset.index,
                         "type",
                         this.value
                     );
                 }
             );
         });
         
         document
         .querySelectorAll(
             ".deleteProcessVariable"
         )
         .forEach(function(button) {
         
             button.addEventListener(
                 "click",
                 function() {
         
                     deleteProcessVariable(
                         processElement,
                         this.dataset.index
                     );
                 }
             );
         });
         }
         
         function updateProcessVariable(
         processElement,
         index,
         property,
         value
         ) {
         
         const variables =
             getProcessVariables(
                 processElement
             );
         
         variables[index][property] =
             value;
         
         modeler
         .get("modeling")
         .updateProperties(
             processElement,
             {}
         );
         }
         
         function deleteProcessVariable(
         processElement,
         index
         ) {
         
         const businessObject =
             processElement.businessObject;
         
         const extensionElements =
             businessObject.extensionElements;
         
         if (
             !extensionElements
         ) {
             return;
         }
         
         const variables =
             getProcessVariables(
                 processElement
             );
         
         const variable =
             variables[index];
         
         const pos =
             extensionElements.values.indexOf(
                 variable
             );
         
         if (
             pos >= 0
         ) {
         
             extensionElements.values.splice(
                 pos,
                 1
             );
         }
         
         modeler
         .get("modeling")
         .updateProperties(
             processElement,
             {}
         );
         
         renderProcessVariables(
             processElement
         );
         }
         
         function getServiceTaskConfig(
         element
         ) {
         
         const businessObject =
             element.businessObject;
         
         const extensionElements =
             businessObject.extensionElements;
         
         if (
             !extensionElements
         ) {
             return null;
         }
         
         return extensionElements.values.find(
             function(v) {
         
                 return (
                     v.$type ===
                     "jq:ServiceTaskConfig"
                 );
             }
         );
         }
         
         function getOrCreateServiceTaskConfig(
         element,
         moddle,
         modeling
         ) {
         
         const businessObject =
             element.businessObject;
         
         let extensionElements =
             businessObject.extensionElements;
         
         if (
             !extensionElements
         ) {
         
             extensionElements =
                 moddle.create(
                     "bpmn:ExtensionElements",
                     {
                         values: []
                     }
                 );
         
             modeling.updateProperties(
                 element,
                 {
                     extensionElements:
                         extensionElements
                 }
             );
         }
         
         let config =
             extensionElements.values.find(
                 function(v) {
         
                     return (
                         v.$type ===
                         "jq:ServiceTaskConfig"
                     );
                 }
             );
         
         if (!config) {
         
             config =
                 moddle.create(
                     "jq:ServiceTaskConfig",
                     {}
                 );
         
             extensionElements.values.push(
                 config
             );
         }
         
         return config;
         }
         
         function saveServiceTaskProperty(
         element,
         propertyName,
         value
         ) {
         
         const moddle =
             modeler.get(
                 "moddle"
             );
         
         const modeling =
             modeler.get(
                 "modeling"
             );
         
         const config =
             getOrCreateServiceTaskConfig(
                 element,
                 moddle,
                 modeling
             );
         
         config[propertyName] =
             value;
         
         modeling.updateProperties(
             element,
             {}
         );
         
         console.log(
             propertyName +
             " Saved:",
             value
         );
         }
         
         function renderTimerProperties(
         element
         ) {
         
         const elementName =
         element.businessObject.name || "";
         
         const container =
             document.getElementById(
                 "jqFormContainer"
             );
         
         const config =
             getEventConfig(
                 element
             );
         
         const eventType =
             config?.eventType ||
             "TIMER";
         
         container.innerHTML =
         '<div class="jq-field">' +
         
         '<label>Element Name</label>' +
         
         '<input type="text" ' +
         
         'id="elementName" ' +
         
         'value="' +
         
         elementName +
         
         '">' +
         
         '</div>' +
         
             '<h3>Event Configuration</h3>' +
         
             '<div class="jq-field">' +
         
                 '<label>Event Type</label>' +
         
                 '<select id="eventType">' +
         
                     '<option value="TIMER"' +
                     (eventType === "TIMER"
                         ? " selected"
                         : "") +
                     '>Timer</option>' +
         
                     '<option value="MESSAGE"' +
                     (eventType === "MESSAGE"
                         ? " selected"
                         : "") +
                     '>Message</option>' +
         
                     '<option value="SIGNAL"' +
                     (eventType === "SIGNAL"
                         ? " selected"
                         : "") +
                     '>Signal</option>' +
         
                 '</select>' +
         
             '</div>';
         
         
         
         document
         .getElementById(
