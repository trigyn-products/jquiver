             ) {
         
                 btn.addEventListener(
                     "click",
                     function() {
         
                         deleteEscalation(
                             element,
                             this.dataset.index
                         );
                     }
                 );
             }
         );
         }
         
         function updateEscalation(
         element,
         index,
         property,
         value
         ) {
         
         const escalations =
             getEscalations(
                 element
             );
         
         if (
             !escalations[index]
         ) {
             return;
         }
         
         escalations[index][property] =
             value;
         
         modeler
         .get("modeling")
         .updateProperties(
             element,
             {}
         );
         }
         function deleteEscalation(
         element,
         index
         ) {
         
         const extensionElements =
             element.businessObject
                 .extensionElements;
         
         if (
             !extensionElements
         ) {
             return;
         }
         
         const escalations =
             getEscalations(
                 element
             );
         
         const escalation =
             escalations[index];
         
         extensionElements.values =
             extensionElements.values.filter(
                 function(v) {
         
                     return (
                         v !== escalation
                     );
                 }
             );
         
         modeler
         .get("modeling")
         .updateProperties(
             element,
             {}
         );
         
         renderEscalations(
             element
         );
         }
         
         function getOrCreateExtensionElements(
         element
         ) {
         
         const moddle =
             modeler.get(
                 "moddle"
             );
         
         const businessObject =
             element.businessObject;
         
         let extensionElements =
             businessObject.extensionElements;
         
         if (
             !extensionElements
         ) {
         
             extensionElements =
                 moddle.create(
                     "bpmn:ExtensionElements",
                     {
                         values: []
                     }
                 );
         
             modeler
             .get("modeling")
             .updateProperties(
                 element,
                 {
                     extensionElements:
                         extensionElements
                 }
             );
         }
         
         return extensionElements;
         }
         
         function getDataMappings(
         element
         ) {
         
         const extensionElements =
             element.businessObject
                 .extensionElements;
         
         if (!extensionElements) {
             return [];
         }
         
         return extensionElements.values.filter(
             function(v) {
         
                 return v.$type ===
                     "jq:DataMapping";
             }
         );
         }
         
         function addDataMapping(
         element
         ) {
         
         const moddle =
             modeler.get("moddle");
         
         const extensionElements =
             getOrCreateExtensionElements(
                 element
             );
         
         const mapping =
             moddle.create(
                 "jq:DataMapping",
                 {
                     sourceField: "",
                     targetVariable: ""
                 }
             );
         
         extensionElements.values.push(
             mapping
         );
         
         modeler
         .get("modeling")
         .updateProperties(
             element,
             {}
         );
         }
         
         function deleteDataMapping(
         element,
         index
         ) {
         
         const mappings =
             getDataMappings(
                 element
             );
         
         const mapping =
             mappings[index];
         
         const extensionElements =
             element.businessObject
                 .extensionElements;
         
         extensionElements.values =
             extensionElements.values.filter(
                 function(v) {
         
                     return v !== mapping;
                 }
             );
         
         modeler
         .get("modeling")
         .updateProperties(
             element,
             {}
         );
         
         renderDataMappings(
             element
         );
         }
         
         function renderDataMappings(
         element
         ) {
         
         const container =
             document.getElementById(
                 "dataMappingContainer"
             );
         
         if (!container) {
             return;
         }
         
         container.innerHTML = "";
         
         const mappings =
             getDataMappings(
                 element
             );
         
         mappings.forEach(
         
             function(
                 mapping,
                 index
             ) {
         
                 container.innerHTML +=
         
                     '<div class="jq-mapping-row">' +
         
                         '<input ' +
                         'class="mappingSource" ' +
                         'data-index="' +
                         index +
                         '" ' +
                         'placeholder="Source Field" ' +
                         'value="' +
                         (mapping.sourceField || "") +
                         '">' +
         
                         '<input ' +
                         'class="mappingTarget" ' +
                         'data-index="' +
                         index +
                         '" ' +
                         'placeholder="Target Variable" ' +
                         'value="' +
                         (mapping.targetVariable || "") +
                         '">' +
         
                         '<button ' +
                         'class="deleteMappingBtn" ' +
                         'data-index="' +
                         index +
                         '">' +
                         'Delete' +
                         '</button>' +
         
                     '</div>';
             }
         );
         
         bindDataMappingEvents(
             element
         );
         }
         
         function updateDataMapping(
         element,
         index,
         propertyName,
         value
         ) {
         
         const mappings =
             getDataMappings(
                 element
             );
         
         if (
             !mappings[index]
         ) {
             return;
         }
         
         mappings[index][propertyName] =
             value;
         
         modeler
         .get("modeling")
         .updateProperties(
             element,
             {}
         );
         }
         
         function bindDataMappingEvents(
         element
         ) {
         
         document
         .querySelectorAll(
             ".mappingSource"
         )
         .forEach(
         
             function(input) {
         
                 input.addEventListener(
                     "change",
                     function(e) {
         
                         updateDataMapping(
                             element,
                             parseInt(
                                 e.target.dataset.index
                             ),
                             "sourceField",
                             e.target.value
                         );
                     }
                 );
             }
         );
         
         document
         .querySelectorAll(
             ".mappingTarget"
         )
         .forEach(
         
             function(input) {
         
                 input.addEventListener(
                     "change",
                     function(e) {
         
                         updateDataMapping(
                             element,
                             parseInt(
                                 e.target.dataset.index
                             ),
                             "targetVariable",
                             e.target.value
                         );
                     }
                 );
             }
         );
         
         document
         .querySelectorAll(
             ".deleteMappingBtn"
         )
         .forEach(
         
             function(button) {
         
                 button.addEventListener(
                     "click",
                     function(e) {
         
                         deleteDataMapping(
                             element,
                             parseInt(
                                 e.target.dataset.index
                             )
                         );
                     }
                 );
             }
         );
         }
         
         
         function getBusinessRule(
         element
         ) {
         
         const extensionElements =
             element.businessObject
                 .extensionElements;
         
         if (
             !extensionElements
         ) {
             return null;
         }
         
         return extensionElements.values.find(
             function(v) {
         
                 return (
                     v.$type ===
                     "jq:BusinessRule"
                 );
             }
         );
         }
         
         function getOrCreateBusinessRule(
         element
         ) {
         
         let rule =
             getBusinessRule(
                 element
             );
         
         if (rule) {
             return rule;
         }
         
         const moddle =
             modeler.get(
                 "moddle"
             );
         
         const extensionElements =
             getOrCreateExtensionElements(
                 element
             );
         
         rule =
             moddle.create(
                 "jq:BusinessRule",
                 {
                     ruleCode: "",
                     ruleType: "JAVA",
                     description: ""
                 }
             );
         
         extensionElements.values.push(
             rule
         );
         
         modeler
         .get("modeling")
         .updateProperties(
             element,
             {}
         );
         
         return rule;
         }
         
         function saveBusinessRuleProperty(
         element,
         propertyName,
         value
         ) {
         
         const rule =
             getOrCreateBusinessRule(
                 element
             );
         
         rule[propertyName] =
             value;
         
         modeler
         .get("modeling")
         .updateProperties(
             element,
             {}
         );
         }
         
         function getFormConfig(
         element
         ) {
         
         const extensionElements =
             element.businessObject
                 .extensionElements;
         
         if (
             !extensionElements
         ) {
             return null;
         }
         
         return extensionElements.values.find(
             function(v) {
         
                 return (
                     v.$type ===
                     "jq:FormConfig"
                 );
             }
         );
         }
         
         function getOrCreateFormConfig(
         element
         ) {
         
         let config =
             getFormConfig(
                 element
             );
         
         if (config) {
             return config;
         }
         
         const moddle =
             modeler.get(
                 "moddle"
             );
         
         const extensionElements =
             getOrCreateExtensionElements(
                 element
             );
         
         config =
             moddle.create(
                 "jq:FormConfig",
                 {
                     formId: "",
                     mode: "EDIT",
                     saveDraft: "false"
                 }
             );
         
         extensionElements.values.push(
             config
         );
         
         modeler
         .get("modeling")
         .updateProperties(
             element,
             {}
         );
         
         return config;
         }
         
         function saveFormConfigProperty(
         element,
         propertyName,
         value
         ) {
         
         const config =
             getOrCreateFormConfig(
                 element
             );
         
         config[propertyName] =
             value;
         
         modeler
         .get("modeling")
         .updateProperties(
             element,
             {}
         );
         }
         
         
         
      </script>
   </body>
</html>