         function getActions(
         element
         ) {
         
         const extensionElements =
             element.businessObject
                 .extensionElements;
         
         if (!extensionElements) {
         
             return [];
         }
         
         return extensionElements.values.filter(
         
             function(v) {
         
                 return (
                     v.$type ===
                     "jq:Action"
                 );
             }
         );
         }
         function addAction(
         element
         ) {
         
         const moddle =
             modeler.get(
                 "moddle"
             );
         
         const modeling =
             modeler.get(
                 "modeling"
             );
         
         let extensionElements =
             element.businessObject
                 .extensionElements;
         
         if (
             !extensionElements
         ) {
         
             extensionElements =
                 moddle.create(
                     "bpmn:ExtensionElements",
                     {
                         values: []
                     }
                 );
         
             modeling.updateProperties(
                 element,
                 {
                     extensionElements:
                         extensionElements
                 }
             );
         }
         
         const action =
             moddle.create(
                 "jq:Action",
                 {
                     name: "",
                     label: ""
                 }
             );
         
         extensionElements.values.push(
             action
         );
         
         modeling.updateProperties(
             element,
             {}
         );
         }
         function renderActions(
    element
) {

    const container =
        document.getElementById(
            "actionContainer"
        );

    container.innerHTML = "";

    const actions =
        getActions(
            element
        );

    const outgoingFlows =
        element.businessObject.outgoing || [];

    actions.forEach(

        function(
            action,
            index
        ) {

            let flowOptions =
                '<option value="">Select Sequence Flow</option>';

            outgoingFlows.forEach(

                function(flow) {

                    flowOptions +=

                        '<option value="' +

                        flow.id +

                        '"' +

                        (action.sequenceFlowId === flow.id
                            ? ' selected'
                            : '') +

                        '>' +

                        flow.id +

                        '</option>';
                }
            );

            container.innerHTML +=

                '<div class="jq-card action-card">' +

                    '<div class="jq-field">' +

                        '<label>Action Name</label>' +

                        '<input ' +
                            'type="text" ' +
                            'class="actionName" ' +
                            'data-index="' + index + '" ' +
                            'value="' + (action.name || "") + '">' +

                    '</div>' +

                    '<div class="jq-field">' +

                        '<label>Outcome</label>' +

                        '<input ' +
                            'type="text" ' +
                            'class="actionOutcome" ' +
                            'data-index="' + index + '" ' +
                            'value="' + (action.outcome || "") + '">' +

                    '</div>' +

                    '<div class="jq-field">' +

                        '<label>Sequence Flow</label>' +

                        '<select ' +
                            'class="actionSequenceFlow" ' +
                            'data-index="' + index + '">' +

                            flowOptions +

                        '</select>' +

                    '</div>' +

                    '<div class="jq-card-actions">' +

                        '<button ' +
                            'class="jq-danger-btn deleteAction" ' +
                            'data-index="' + index + '">' +

                            'Delete Action' +

                        '</button>' +

                    '</div>' +

                '</div>';

        }
    );

    bindActionEvents(
        element
    );
}
         function bindActionEvents(
         element
         ) {
         
         document
         .querySelectorAll(
             ".actionName"
         )
         .forEach(function(input) {
         
             input.addEventListener(
                 "change",
                 function() {
         
                     updateAction(
                         element,
                         this.dataset.index,
                         "name",
                         this.value
                     );
                 }
             );
         });
         
         document
         .querySelectorAll(
             ".actionOutcome"
         )
         .forEach(function(input) {
         
             input.addEventListener(
                 "change",
                 function() {
         
                     updateAction(
                         element,
                         this.dataset.index,
                         "outcome",
                         this.value
                     );
                 }
             );
         });
         
         document
         .querySelectorAll(
             ".actionSequenceFlow"
         )
         .forEach(function(select) {
         
             select.addEventListener(
                 "change",
                 function() {
         
                     updateAction(
                         element,
                         this.dataset.index,
                         "sequenceFlowId",
                         this.value
                     );
                 }
             );
         });
         
         document
         .querySelectorAll(
             ".deleteAction"
         )
         .forEach(function(button) {
         
             button.addEventListener(
                 "click",
                 function() {
         
                     deleteAction(
                         element,
                         this.dataset.index
                     );
                 }
             );
         });
         }
         function updateAction(
         element,
         index,
         property,
         value
         ) {
         
         const actions =
             getActions(
                 element
             );
         
         if (
             !actions[index]
         ) {
             return;
         }
         
         actions[index][property] =
             value;
         
         modeler
         .get("modeling")
         .updateProperties(
             element,
             {}
         );
         }
         function deleteAction(
         element,
         index
         ) {
         
         const extensionElements =
             element.businessObject
                 .extensionElements;
         
         if (
             !extensionElements
         ) {
             return;
         }
         
         const actions =
             getActions(
                 element
             );
         
         const action =
             actions[index];
         
         extensionElements.values =
             extensionElements.values.filter(
                 function(v) {
         
                     return v !== action;
                 }
             );
         
         modeler
         .get("modeling")
         .updateProperties(
             element,
             {}
         );
         
         renderActions(
             element
         );
         }
         
         
         
         function getPermissions(
         element
         ) {
         
         const extensionElements =
             element.businessObject
                 .extensionElements;
         
         if (
             !extensionElements
         ) {
             return [];
         }
         
         return extensionElements.values.filter(
             function(v) {
         
                 return (
                     v.$type ===
                     "jq:Permission"
                 );
             }
         );
         }
         function addPermission(
         element
         ) {
         
         const moddle =
             modeler.get(
                 "moddle"
             );
         
         const modeling =
             modeler.get(
                 "modeling"
             );
         
         const businessObject =
             element.businessObject;
         
         let extensionElements =
             businessObject.extensionElements;
         
         if (
             !extensionElements
         ) {
         
             extensionElements =
                 moddle.create(
                     "bpmn:ExtensionElements",
                     {
                         values: []
                     }
                 );
         
             modeling.updateProperties(
                 element,
                 {
                     extensionElements:
                         extensionElements
                 }
             );
         }
         
         const permission =
             moddle.create(
                 "jq:Permission",
                 {
                     role: "",
                     canView: true,
                     canEdit: false,
                     canComment: false,
                     canUpload: false
                 }
             );
         
         extensionElements.values.push(
             permission
         );
         
         modeling.updateProperties(
             element,
             {}
         );
         }
         function renderPermissions(
    element
) {

    const container =
        document.getElementById(
            "permissionContainer"
        );

    container.innerHTML =
        "";

    const permissions =
        getPermissions(
            element
        );

    permissions.forEach(

        function(
            permission,
            index
        ) {

            container.innerHTML +=

                '<div class="jq-card permission-card">' +

                    '<div class="jq-field">' +

                        '<label>Role</label>' +

                        '<select class="permissionRole" data-index="' +
                        index +
                        '">' +

                            '<option value="">Select Role</option>' +

                            ROLE_OPTIONS.map(function(role){

                                return '<option value="' +
                                    role.id +
                                    '"' +
                                    (permission.role === role.id
                                        ? ' selected'
                                        : '') +
                                    '>' +
                                    role.name +
                                    '</option>';

                            }).join("") +

                        '</select>' +

                    '</div>' +

                    '<div class="permission-checkboxes">' +

                        '<label>' +
                        '<input type="checkbox" class="canView" data-index="' +
                        index +
                        '"' +
                        (permission.canView
                            ? ' checked'
                            : '') +
                        '> View' +
                        '</label>' +

                        '<label>' +
                        '<input type="checkbox" class="canEdit" data-index="' +
                        index +
                        '"' +
                        (permission.canEdit
                            ? ' checked'
                            : '') +
                        '> Edit' +
                        '</label>' +

                        '<label>' +
                        '<input type="checkbox" class="canComment" data-index="' +
                        index +
                        '"' +
                        (permission.canComment
                            ? ' checked'
                            : '') +
                        '> Comment' +
                        '</label>' +

                        '<label>' +
                        '<input type="checkbox" class="canUpload" data-index="' +
                        index +
                        '"' +
                        (permission.canUpload
                            ? ' checked'
                            : '') +
                        '> Upload' +
                        '</label>' +

                    '</div>' +

                    '<div class="jq-card-actions">' +

                        '<button class="jq-danger-btn deletePermission" data-index="' +
                        index +
                        '">' +

                        'Delete Permission' +

                        '</button>' +

                    '</div>' +

                '</div>';

        }
    );

    bindPermissionEvents(
        element
    );
}

