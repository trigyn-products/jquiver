             );
         
         const config =
             getEndEventConfig(
                 element
             );
         
         const result =
             config?.result ||
             "COMPLETED";
         
         container.innerHTML =
         
             '<div class="jq-field">' +
         
                 '<label>Element Name</label>' +
         
                 '<input type="text" ' +
                 'id="elementName" ' +
