<#assign scriptNonce = (enableCSP?? && enableCSP && dynamicNonce??)?then('nonce="${dynamicNonce}"', '') />
<!DOCTYPE html>
<html lang="en">
   <head>
      <meta charset="UTF-8">
      <meta name="viewport"
         content="width=device-width, initial-scale=1.0">
      <title>BPMN Designer</title>
      <link rel="stylesheet"
         href="https://unpkg.com/bpmn-js@17.9.2/dist/assets/diagram-js.css">
      <link rel="stylesheet"
         href="https://unpkg.com/bpmn-js@17.9.2/dist/assets/bpmn-js.css">
      <link rel="stylesheet"
         href="https://unpkg.com/bpmn-js@17.9.2/dist/assets/bpmn-font/css/bpmn.css">
      <link rel="stylesheet"
         href="https://unpkg.com/@bpmn-io/properties-panel/dist/assets/properties-panel.css">
      <!-- BPMN MODELER -->
      <script src="${(contextPath)!''}/webjars/1.0/bpmn/js/bpmn-modeler.development.js"></script>
      <!-- PROPERTIES PANEL -->
      <script src="${(contextPath)!''}/webjars/1.0/bpmn/js/bpmn-js-properties-panel.umd.js"></script>
      <!-- BPMN PROVIDER -->
     <!-- <script src="https://unpkg.com/bpmn-js-properties-panel@5/dist/provider/bpmn.umd.js"></script>-->
      <script src="${(contextPath)!''}/webjars/1.0/bpmn/js/jq-properties-provider.js" ></script>
      <script src="${(contextPath)!''}/webjars/1.0/bpmn/js/jq-extension-utils.js" ></script>
      <script src="${(contextPath)!''}/webjars/1.0/bpmn/js/jq-palette-provider.js"></script>
      <script ${scriptNonce}>
         window.BpmnPropertiesPanelModule =
             BpmnJSPropertiesPanel.BpmnPropertiesPanelModule;
         
         window.BpmnPropertiesProviderModule =
             BpmnJSPropertiesPanel.BpmnPropertiesProviderModule;
         
      </script>
      <style>
         html,
         body {
         margin: 0;
         padding: 0;
         height: 100%;
         overflow: hidden;
         font-family: Arial, sans-serif;
         }
         .main-designer-container {
         display: flex;
         width: 100vw;
         height: 100vh;
         }
         /*
         * -----------------------------------
         * LEFT TOOLBAR
         * -----------------------------------
         */
         .toolbar {
         width: 70px;
         background: #1f2937;
         display: flex;
         flex-direction: column;
         align-items: center;
         padding-top: 10px;
         gap: 10px;
         flex-shrink: 0;
         }
         .toolbar button {
         width: 50px;
         height: 50px;
         border: none;
         border-radius: 8px;
         cursor: pointer;
         background: #374151;
         color: white;
         font-size: 12px;
         }
         .toolbar button:hover {
         background: #4b5563;
         }
         /*
         * -----------------------------------
         * MAIN AREA
         * -----------------------------------
         */
         .designer-container {
         flex: 1;
         display: flex;
         flex-direction: column;
         overflow: hidden;
         }
         /*
         * -----------------------------------
         * TOPBAR
         * -----------------------------------
         */
         .topbar {
         height: 60px;
         background: white;
         border-bottom: 1px solid #ddd;
         display: flex;
         align-items: center;
         justify-content: space-between;
         padding: 0 20px;
         flex-shrink: 0;
         }
         /*
         * -----------------------------------
         * CANVAS WRAPPER
         * -----------------------------------
         */
         .canvas-wrapper {
         flex: 1;
         display: flex;
         overflow: hidden;
         }
         #designerContainer {
         display: flex;
         width: 100%;
         height: 100%;
         }
         /*
         * -----------------------------------
         * BPMN CANVAS
         * -----------------------------------
         */
         #canvas {
         flex-grow: 1;
         height: 100%;
         position: relative;
         }
         /*
         * -----------------------------------
         * PROPERTIES PANEL
         * -----------------------------------
         */
         #properties {
         width: 350px;
         height: 100%;
         overflow: hidden;
         border-left: 1px solid #ccc;
         background: #fff;
         }
         /*
         * -----------------------------------
         * STATUS BAR
         * -----------------------------------
         */
         .status-bar {
         height: 35px;
         background: white;
         border-top: 1px solid #ddd;
         display: flex;
         align-items: center;
         padding: 0 15px;
         font-size: 13px;
         }
         /*
         * -----------------------------------
         * FILE INPUT
         * -----------------------------------
         */
         .file-input {
         display: none;
         }
         /*
         * HIDE WATERMARK
         */
         .bjs-powered-by {
         display: none !important;
         }
         .properties-panel-parent,
         .bio-properties-panel,
         .djs-container,
         .djs-parent {
         height: 100%;
         }
         #rightPanel {
         width: 400px;
         display: flex;
         flex-direction: column;
         border-left: 1px solid #ccc;
         background: white;
         }
         #properties {
         flex: 1;
         overflow: auto;
         }
         #jqProperties {
         height: 350px;
         border-top: 1px solid #ddd;
         padding: 10px;
         overflow: auto;
         }
         #jqProperties h3 {
         margin-top: 0;
         }
         /* ===========================
         JQuiver Property Panel
         =========================== */
         #jqFormContainer{
         padding:16px;
         box-sizing:border-box;
         overflow-y:auto;
         }
         #jqFormContainer h3{
         margin:22px 0 12px;
         padding-bottom:6px;
         font-size:18px;
         font-weight:600;
         border-bottom:1px solid #ddd;
         }
         .jq-field{
         margin-bottom:14px;
         display:flex;
         flex-direction:column;
         }
         .jq-field label{
         margin-bottom:5px;
         font-size:13px;
         font-weight:600;
         color:#444;
         }
         .jq-field input,
         .jq-field select,
         .jq-field textarea{
         width:100%;
         padding:8px 10px;
         border:1px solid #cfcfcf;
         border-radius:4px;
         font-size:13px;
         box-sizing:border-box;
         background:#fff;
         }
         .jq-field textarea{
         min-height:70px;
         resize:vertical;
         }
         .jq-field input:focus,
         .jq-field select:focus,
         .jq-field textarea:focus{
         outline:none;
         border-color:#1976d2;
         box-shadow:0 0 3px rgba(25,118,210,.25);
         }
         /* checkbox */
         .jq-checkbox{
         display:flex;
         align-items:center;
         gap:8px;
         margin-bottom:12px;
         }
         .jq-checkbox label{
         margin:0;
         }
         /* section */
         .jq-section{
         margin-top:20px;
         padding:15px;
         border:1px solid #ddd;
         border-radius:5px;
         background:#fafafa;
         }
         /* buttons */
         .jq-btn{
         padding:7px 14px;
         border:none;
         background:#1976d2;
         color:white;
         border-radius:4px;
         cursor:pointer;
         font-size:13px;
         }
         .jq-btn:hover{
         background:#135ba1;
         }
         /* remove buttons */
         .jq-delete{
         background:#d32f2f;
         }
         .jq-delete:hover{
         background:#b71c1c;
         }
         /* table-like rows */
         .jq-row{
         display:grid;
         grid-template-columns:
         1fr
         1fr
         auto;
         gap:10px;
         margin-bottom:10px;
         align-items:center;
         }
         /* small title */
         .jq-title{
         font-size:15px;
         font-weight:600;
         margin-bottom:12px;
         }
         .jq-properties-panel {
         background: #ffffff;
         border-left: 1px solid #ddd;
         padding: 0;
         margin: 0;
         overflow-y: auto;
         height: calc(100vh - 190px);
         }
         .jq-panel-section {
         border-top: 1px solid #ececec;
         padding: 18px;
         }
         .jq-panel-title {
         font-size: 14px;
         font-weight: 600;
         color: #333;
         margin-bottom: 16px;
         }
         .jq-panel-section {
         padding: 18px;
         border-top: 1px solid #e5e5e5;
         }
         .jq-panel-title {
         font-size: 15px;
         font-weight: 600;
         color: #333;
         margin-bottom: 14px;
         }
         .jq-primary-btn {
         padding: 7px 14px;
         border: none;
         border-radius: 4px;
         background: #1976d2;
         color: white;
         cursor: pointer;
         font-size: 13px;
         margin-bottom: 12px;
         }
         .jq-primary-btn:hover {
         background: #1565c0;
         }
         .jq-card {
         border: 1px solid #dcdcdc;
         border-radius: 6px;
         background: #fafafa;
         padding: 16px;
         margin-bottom: 12px;
         }
         .jq-card-actions {
         margin-top: 14px;
         text-align: right;
         }
         .jq-danger-btn {
         background: #dc3545;
         color: white;
         border: none;
         padding: 6px 12px;
         border-radius: 4px;
         cursor: pointer;
         }
         .jq-danger-btn:hover {
         background: #b52b38;
         }

         .action-card{

    margin-top:12px;

}

.action-card .jq-field{

    margin-bottom:14px;

}

.action-card label{

    display:block;

    font-size:13px;

    font-weight:600;

    margin-bottom:6px;

    color:#555;

}

.action-card input,
.action-card select{

    width:100%;

    box-sizing:border-box;

}

.action-card .jq-card-actions{

    text-align:right;

    margin-top:10px;

}
.permission-card{

    margin-top:12px;

}

.permission-card .jq-field{

    margin-bottom:14px;

}

.permission-card label{

    font-size:13px;

    font-weight:600;

    color:#555;

}

.permission-checkboxes{

    display:grid;

    grid-template-columns:repeat(2,1fr);

    gap:10px 18px;

    margin-top:10px;

    margin-bottom:15px;

}

.permission-checkboxes label{

    display:flex;

    align-items:center;

    gap:8px;

    font-weight:500;

    cursor:pointer;

}

.permission-checkboxes input{

    width:auto;

}

.permission-card .jq-card-actions{

    text-align:right;

}
.notification-card{

    margin-top:12px;

}

.notification-card .jq-field{

    margin-bottom:14px;

}

.notification-card label{

    display:block;

    font-size:13px;

    font-weight:600;

    color:#555;

    margin-bottom:6px;

}

.notification-card input,
.notification-card select{

    width:100%;

    box-sizing:border-box;

}

.notification-card .jq-card-actions{

    margin-top:12px;

    text-align:right;

}

      </style>
   </head>
   <body>
      <div class="main-designer-container">
         <!-- LEFT TOOLBAR -->
         <div class="toolbar">
            <button id="newDiagramBtn">New</button>
            <button id="saveBtn">Save</button>
            <button id="downloadBtn">XML</button>
            <button id="uploadBtn">Open</button>
            <button id="zoomInBtn">+</button>
            <button id="zoomOutBtn">-</button>
            <button id="fitBtn">Fit</button>
         </div>
         <!-- MAIN -->
         <div class="designer-container">
            <!-- TOPBAR -->
            <div class="topbar">
               <h2>BPMN Workflow Designer</h2>
               <div>
                  <label>
                  Process Key:
                  <input type="text"
                     id="processKey"
                     value="leave_process"
                     style="padding: 6px;">
                  </label>
               </div>
            </div>
            <!-- DESIGNER -->
            <div id="designerContainer"
               class="canvas-wrapper">
               <div id="canvas"></div>
               <div id="rightPanel">
                  <div id="properties"
                     class="properties-panel-parent">
                  </div>
                  <div id="jqProperties" class="jq-properties-panel">
                     <!-- User Task Configuration -->
                     <div class="jq-panel-section">
                        <div id="jqFormContainer">
                           Select a User Task
                        </div>
                     </div>
                     <!-- Workflow Variables -->
                     <div class="jq-panel-section">
                        <div class="jq-panel-title">
                           Workflow Variables
                        </div>
                        <button id="addVariableBtn"  class="jq-primary-btn">
                        + Add Variable
                        </button>
                        <div id="variableContainer">
                        </div>
                     </div>
                     <!-- Process Variables -->
                     <div class="jq-panel-section">
                        <div class="jq-panel-title">
                           Process Variables
                        </div>
                        <button
                           id="addProcessVariableBtn"   class="jq-primary-btn">
                        + Add Process Variable
                        </button>
                        <div id="processVariableContainer">
                        </div>
                     </div>
                     <!-- Workflow Configuration -->
                     <div class="jq-panel-section">
                        <div class="jq-panel-title">
                           Workflow Configuration
                        </div>
                        <div id="processConfigContainer">
                        </div>
                     </div>
                  </div>
               </div>
            </div>
            <!-- STATUS -->
            <div class="status-bar">
               <span id="statusText">Ready</span>
            </div>
         </div>
      </div>
      <input type="file"
         id="fileInput"
         class="file-input"
         accept=".bpmn,.xml">
      <script ${scriptNonce}>
         /*
          * ---------------------------------------------------------
          * BPMN PROPERTY PANEL MODULES
          * ---------------------------------------------------------
          */
         contextPath = "${contextPath}";
         const BpmnPropertiesPanelModule =
             window.BpmnJSPropertiesPanel.BpmnPropertiesPanelModule;
         
         const BpmnPropertiesProviderModule =
             window.BpmnPropertiesProviderModule;
         
         const JqPropertiesProviderModule =
         window.JqPropertiesProvider;
         
         const JqPaletteProviderModule =   window.JqPaletteProvider;
         
         
         
         let modeler;
         
         const jquiverModdle = {
         
         name: "JQ",
         
         uri: "http://jquiver.com/workflow",
         
         prefix: "jq",
         
         xml: {
             tagAlias: "lowerCase"
         },
         
         types: [
         {
         name: "TaskConfig",
         
         superClass: [
             "Element"
         ],
         
         meta: {
             allowedIn: [
                 "bpmn:ExtensionElements"
             ]
         },
         
         
         properties: [
         
         {
             name: "taskCode",
             isAttr: true,
             type: "String"
         },
         
         {
             name: "taskName",
             isAttr: true,
             type: "String"
         },
         
         {
             name: "taskType",
             isAttr: true,
             type: "String"
         },
         
         {
             name: "formId",
             isAttr: true,
             type: "String"
         },
         
         {
             name: "assigneeType",
             isAttr: true,
             type: "String"
         },
         
         {
             name: "assigneeValue",
             isAttr: true,
             type: "String"
         },
         
         {
             name: "slaHours",
             isAttr: true,
             type: "String"
         },
         
         {
             name: "canReassign",
             isAttr: true,
             type: "Boolean"
         },
         
         {
             name: "canDelegate",
             isAttr: true,
             type: "Boolean"
         }
         ]
         },
         {
         name: "Variable",
         
         superClass: [
             "Element"
         ],
         
         meta: {
             allowedIn: [
                 "bpmn:ExtensionElements"
             ]
         },
         
         properties: [
         
             {
                 name: "name",
                 isAttr: true,
                 type: "String"
             },
         
             {
                 name: "type",
                 isAttr: true,
                 type: "String"
             }
         ]
         },
         {
         name: "Condition",
         
         superClass: [
             "Element"
         ],
         
         meta: {
             allowedIn: [
                 "bpmn:ExtensionElements"
             ]
         },
         
         properties: [
         
             {
                 name: "type",
                 isAttr: true,
                 type: "String"
             },
         
             {
                 name: "expression",
                 isAttr: true,
                 type: "String"
             }
         ]
         },{
         name: "ServiceTaskConfig",
         
         superClass: [
             "Element"
         ],
         
         meta: {
             allowedIn: [
                 "bpmn:ExtensionElements"
             ]
         },
         
         properties: [
         
             {
                 name: "taskCode",
                 isAttr: true,
                 type: "String"
             },
         
             {
                 name: "serviceType",
                 isAttr: true,
                 type: "String"
             },
         
             {
                 name: "endpoint",
                 isAttr: true,
                 type: "String"
             },
         
             {
                 name: "method",
                 isAttr: true,
                 type: "String"
             }
         ]
         },{
         name: "TimerConfig",
         
         superClass: [
             "Element"
         ],
         
         meta: {
             allowedIn: [
                 "bpmn:ExtensionElements"
             ]
         },
         
         properties: [
         
             {
                 name: "timerType",
                 isAttr: true,
                 type: "String"
             },
         
             {
                 name: "timerValue",
                 isAttr: true,
                 type: "String"
             }
         ]
         },{
         name: "EventConfig",
         
         superClass: [
             "Element"
         ],
         
         meta: {
             allowedIn: [
                 "bpmn:ExtensionElements"
             ]
         },
         
         properties: [
         
             {
                 name: "eventType",
                 isAttr: true,
                 type: "String"
             }
         ]
         },{
         name: "ProcessConfig",
         
         superClass: [
             "Element"
         ],
         
         meta: {
             allowedIn: [
                 "bpmn:ExtensionElements"
             ]
         },
         
         properties: [
         
             {
                 name: "workflowCode",
                 isAttr: true,
                 type: "String"
             },
         
             {
                 name: "workflowName",
                 isAttr: true,
                 type: "String"
             },
         
             {
                 name: "version",
                 isAttr: true,
                 type: "String"
             },
         
             {
                 name: "category",
                 isAttr: true,
                 type: "String"
             },
         
             {
                 name: "description",
                 isAttr: true,
                 type: "String"
             },
             {
                 name: "isActive",
                 isAttr: true,
                 type: "Boolean"
             }
         ]
         },
         {
         name: "StartEventConfig",
         
         superClass: ["Element"],
         
         meta: {
             allowedIn: [
                 "bpmn:ExtensionElements"
             ]
         },
         
         properties: [
         
             {
                 name: "eventType",
                 isAttr: true,
                 type: "String"
             }
         ]
         },
         {
         name: "EndEventConfig",
         
         superClass: [
             "Element"
         ],
         
         meta: {
             allowedIn: [
                 "bpmn:ExtensionElements"
             ]
         },
         
         properties: [
         
             {
                 name: "result",
                 isAttr: true,
                 type: "String"
             }
         ]
         },{
         name: "ProcessConfig",
         
         superClass: ["Element"],
         
         meta: {
             allowedIn: [
                 "bpmn:ExtensionElements"
             ]
         },
         
         properties: [
         
             {
                 name: "processKey",
                 isAttr: true,
                 type: "String"
             },
         
             {
                 name: "processName",
                 isAttr: true,
                 type: "String"
             },
         
             {
                 name: "version",
                 isAttr: true,
                 type: "String"
             }
         ]
         },
         {
         name: "Action",
         
         superClass: ["Element"],
         
         meta: {
             allowedIn: [
                 "bpmn:ExtensionElements"
             ]
         },
         
         properties: [
         
             {
                 name: "name",
                 isAttr: true,
                 type: "String"
             },
         
             {
                 name: "outcome",
                 isAttr: true,
                 type: "String"
             },
         
             {
                 name: "sequenceFlowId",
                 isAttr: true,
                 type: "String"
             }
         ]
         },
         {
         name: "Permission",
         
         superClass: [
             "Element"
         ],
         
         meta: {
             allowedIn: [
                 "bpmn:ExtensionElements"
             ]
         },
         
         properties: [
         
             {
                 name: "role",
                 isAttr: true,
                 type: "String"
             },
         
             {
                 name: "canView",
                 isAttr: true,
                 type: "Boolean"
             },
         
             {
                 name: "canEdit",
                 isAttr: true,
                 type: "Boolean"
             },
         
             {
                 name: "canComment",
                 isAttr: true,
                 type: "Boolean"
             },
         
             {
                 name: "canUpload",
                 isAttr: true,
                 type: "Boolean"
             }
         ]
         },
         {
         name: "Notification",
         
         superClass: [
             "Element"
         ],
         
         meta: {
             allowedIn: [
                 "bpmn:ExtensionElements"
             ]
         },
         
         properties: [
         
             {
                 name: "event",
                 isAttr: true,
                 type: "String"
             },
         
             {
                 name: "type",
                 isAttr: true,
                 type: "String"
             },
         
             {
                 name: "template",
                 isAttr: true,
                 type: "String"
             },
         
             {
                 name: "recipientType",
                 isAttr: true,
                 type: "String"
             },
         
             {
                 name: "recipientValue",
                 isAttr: true,
                 type: "String"
             }
         ]
         },{
         name: "Sla",
         
         superClass: [
             "Element"
         ],
         
         meta: {
             allowedIn: [
                 "bpmn:ExtensionElements"
             ]
         },
         
         properties: [
         
             {
                 name: "durationHours",
                 isAttr: true,
                 type: "String"
             },
         
             {
                 name: "reminderHours",
                 isAttr: true,
                 type: "String"
             },
         
             {
                 name: "escalationRole",
                 isAttr: true,
                 type: "String"
             },
         
             {
                 name: "autoAction",
                 isAttr: true,
                 type: "String"
             }
         ]
         },
         {
         name: "Escalation",
         
         superClass: ["Element"],
         
         meta: {
             allowedIn: [
                 "bpmn:ExtensionElements"
             ]
         },
         
         properties: [
         
             {
                 name: "level",
                 isAttr: true,
                 type: "String"
             },
         
             {
                 name: "afterHours",
                 isAttr: true,
                 type: "String"
             },
         
             {
                 name: "role",
                 isAttr: true,
                 type: "String"
             },
         
             {
                 name: "action",
                 isAttr: true,
                 type: "String"
             }
         ]
         },
         {
         "name": "DataMapping",
         
         "superClass": [
         "Element"
         ],
         
         "meta": {
         "allowedIn": [
           "bpmn:ExtensionElements"
         ]
         },
         
         "properties": [
         
         {
           "name": "sourceField",
           "isAttr": true,
           "type": "String"
         },
         
         {
           "name": "targetVariable",
           "isAttr": true,
           "type": "String"
         }
         ]
         },
         {
         name: "BusinessRule",
         
         superClass: ["Element"],
         
         meta: {
             allowedIn: [
                 "bpmn:ExtensionElements"
             ]
         },
         
         properties: [
         
             {
                 name: "ruleCode",
                 isAttr: true,
                 type: "String"
             },
         
             {
                 name: "ruleType",
                 isAttr: true,
                 type: "String"
             },
         
             {
                 name: "description",
                 isAttr: true,
                 type: "String"
             }
         ]
         },
         {
         name: "FormConfig",
         
         superClass: ["Element"],
         
         meta: {
             allowedIn: [
                 "bpmn:ExtensionElements"
             ]
         },
         
         properties: [
         
             {
                 name: "formId",
                 isAttr: true,
                 type: "String"
             },
         
             {
                 name: "mode",
                 isAttr: true,
                 type: "String"
             },
         
             {
                 name: "saveDraft",
                 isAttr: true,
                 type: "String"
             }
         ]
         }
         ]
         };
         
         const STORAGE_KEY =
             "CURRENT_BPMN_XML";
         
         /*
          * ---------------------------------------------------------
          * DEFAULT BPMN XML
          * ---------------------------------------------------------
          */
         
         const defaultDiagram =
         `<?xml version="1.0" encoding="UTF-8"?>
         <bpmn:definitions
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
         xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
         xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
         xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
         id="Definitions_1"
         targetNamespace="http://bpmn.io/schema/bpmn">
         
         <bpmn:process
         id="Process_1"
         isExecutable="false">
         
         <bpmn:startEvent id="StartEvent_1"/>
         
         </bpmn:process>
         
         <bpmndi:BPMNDiagram id="BPMNDiagram_1">
         
         <bpmndi:BPMNPlane
             id="BPMNPlane_1"
             bpmnElement="Process_1">
         
             <bpmndi:BPMNShape
                 id="_BPMNShape_StartEvent_2"
                 bpmnElement="StartEvent_1">
         
                 <dc:Bounds
                     x="173"
                     y="102"
                     width="36"
                     height="36"/>
         
             </bpmndi:BPMNShape>
         
         </bpmndi:BPMNPlane>
         
         </bpmndi:BPMNDiagram>
         
         </bpmn:definitions>`;
         
         /*
          * ---------------------------------------------------------
          * STATUS
          * ---------------------------------------------------------
          */
         
         function updateStatus(message) {
         
             const element =
                 document.getElementById(
                     "statusText"
                 );
         
             if (element) {
         
                 element.innerText =
                     message;
             }
         }
         
         /*
          * ---------------------------------------------------------
          * INITIALIZE MODELER
          * ---------------------------------------------------------
          */
         
         async function initializeModeler() {
         
             try {
         
                 modeler =  new BpmnJS({
         
                         container:
                             "#canvas",
         
                         keyboard: {
                             bindTo: window
                         },
         
                         propertiesPanel: {
                             parent: "#properties"
                         },
         
                         moddleExtensions: {
                             jq: jquiverModdle
                         },
         
                         additionalModules: [
         
                             BpmnPropertiesPanelModule,
         
                             BpmnPropertiesProviderModule,
         
                             JqPropertiesProviderModule,
         
                             JqPaletteProviderModule
                         ]
                     });
         
                     window.modeler = modeler;
         
                    loadMasterData();
         
                 updateStatus(
                     "BPMN Designer Ready"
                 );
         
             } catch (err) {
         
                 console.error(err);
         
                 updateStatus(
                     "Initialization Failed"
                 );
             }
         }
         
         /*
          * ---------------------------------------------------------
          * LOAD DIAGRAM
          * ---------------------------------------------------------
          */
         
         async function loadDiagram(
             xml,
             message
         ) {
         
             try {
         
                 await modeler.importXML(xml);
         
                 const canvas =
                     modeler.get("canvas");
         
                 canvas.zoom(
                     "fit-viewport"
                 );
         
                 updateStatus(message);
         
             } catch (err) {
         
                 console.error(err);
         
                 updateStatus(
                     "Failed To Load BPMN"
                 );
             }
         }
         
         /*
          * ---------------------------------------------------------
          * NEW DIAGRAM
          * ---------------------------------------------------------
          */
         
         async function createNewDiagram() {
         
             await loadDiagram(
                 defaultDiagram,
                 "New Diagram Created"
             );
         }
         
         /*
          * ---------------------------------------------------------
          * SAVE
          * ---------------------------------------------------------
          */
         
         async function saveDiagram() {
         
             try {
         
                 const { xml } =
                     await modeler.saveXML({
                         format: true
                     });
         
         
             // Store locally
             localStorage.setItem(
                 STORAGE_KEY,
                 xml
             );
         
             // Send to parent window
             if (
                 window.opener &&
                 !window.opener.closed
             ) {
         
                 window.opener.postMessage({
                     type: "BPMN_XML",
                     xml: xml
                 }, "*");
             }
         
             updateStatus(
                 "Workflow Sent Successfully"
             );
         
             // Auto close popup
             window.close();
             } catch (err) {
         
                 console.error(err);
         
                 updateStatus(
                     "Save Failed"
                 );
             }
         }
         
         /*
          * ---------------------------------------------------------
          * DOWNLOAD XML
          * ---------------------------------------------------------
          */
         
         async function downloadDiagram() {
         
             try {
         
                 const { xml } =
                     await modeler.saveXML({
                         format: true
                     });
         
                 const blob =
                     new Blob(
                         [xml],
                         {
                             type:
                             "application/xml"
                         }
                     );
         
                 const url =
                     URL.createObjectURL(
                         blob
                     );
         
                 const link =
                     document.createElement(
                         "a"
                     );
         
                 link.href = url;
         
                 link.download =
                     "workflow.bpmn";
         
                 document.body
                     .appendChild(link);
         
                 link.click();
         
                 document.body
                     .removeChild(link);
         
                 URL.revokeObjectURL(
                     url
                 );
         
                 updateStatus(
                     "Diagram Downloaded"
                 );
         
             } catch (err) {
         
                 console.error(err);
         
                 updateStatus(
                     "Download Failed"
                 );
             }
         }
         
         /*
          * ---------------------------------------------------------
          * IMPORT FILE
          * ---------------------------------------------------------
          */
         
         function openDiagram() {
         
             document
                 .getElementById(
                     "fileInput"
                 )
                 .click();
         }
         
         async function handleFileSelect(
             event
         ) {
         
             const file =
                 event.target.files[0];
         
             if (!file) {
                 return;
             }
         
             const reader =
                 new FileReader();
         
             reader.onload =
                 async function(e) {
         
                     try {
         
                         const xml =
                             e.target.result;
         
                         await loadDiagram(
                             xml,
                             "Diagram Imported"
                         );
         
                         localStorage.setItem(
                             STORAGE_KEY,
                             xml
                         );
         
                     } catch (err) {
         
                         console.error(err);
         
                         updateStatus(
                             "Invalid BPMN File"
                         );
                     }
                 };
         
             reader.readAsText(file);
         }
         
         /*
          * ---------------------------------------------------------
          * ZOOM
          * ---------------------------------------------------------
          */
         
         function zoomIn() {
         
             const canvas =
                 modeler.get("canvas");
         
             canvas.zoom(
                 canvas.zoom() + 0.1
             );
         }
         
         function zoomOut() {
         
             const canvas =
                 modeler.get("canvas");
         
             canvas.zoom(
                 canvas.zoom() - 0.1
             );
         }
         
         function fitDiagram() {
         
             modeler
                 .get("canvas")
                 .zoom("fit-viewport");
         }
         
         /*
          * ---------------------------------------------------------
          * AUTO SAVE EVENTS
          * ---------------------------------------------------------
          */
         
         function registerEvents() {
         
             const eventBus =
                 modeler.get("eventBus");
         
                eventBus.on(
                             "selection.changed",
                             function(event) {
         
                                 const selected =
                                     event.newSelection[0];
         
                                console.log(
                                     "Selected Type:",
                                     selected?.type
                                 );
         
                                 if (
                                         selected &&
                                         selected.type ===
                                         "bpmn:StartEvent"
                                     ) {
         
                                         renderStartEventProperties(
                                             selected
                                         );
                                     } else if (
                                         selected &&
                                         selected.type ===
                                         "bpmn:UserTask"
                                     ) {
         
                                         renderJqProperties(
                                             selected
                                         );
                                     }
                                     else if (
                                         selected &&
                                         selected.type ===
                                         "bpmn:SequenceFlow"
                                     )  {
         
                                         renderSequenceFlowProperties(
                                             selected
                                         );
                                     }
                                     
                                     else if (
                                         selected &&
                                         selected.type === "bpmn:ServiceTask"
                                     ){
         
                                         renderServiceTaskProperties(
                                             selected
                                         );
                                     }
                                     else if (
                                         selected &&
                                         (
                                             selected.type === "bpmn:IntermediateCatchEvent"
                                             ||
                                             selected.type === "bpmn:IntermediateThrowEvent"
                                             ||
                                             selected.type === "bpmn:BoundaryEvent"
                                         )
                                     ) {
         
                                         renderTimerProperties(
                                             selected
                                         );
                                     }
                                     else if (
                                             selected &&
                                             (
                                                 selected.type ===
                                                 "bpmn:ExclusiveGateway"
         
                                                 ||
         
                                                 selected.type ===
                                                 "bpmn:ParallelGateway"
                                             )
                                         ) {
         
                                             renderGatewayProperties(
                                                 selected
                                             );
                                         }
                                        else if (
                                                 selected &&
                                                 selected.type ===
                                                 "bpmn:EndEvent"
                                             ) {
         
                                                 renderEndEventProperties(
                                                     selected
                                                 );
                                             }
                                     else {
         
                                         document
                                             .getElementById(
                                                 "jqFormContainer"
                                             )
                                             .innerHTML =
                                             "Select a BPMN Element";
                                     }
                             }
                         );
             eventBus.on(
                 "commandStack.changed",
                 async function() {
         
                     try {
         
                         const { xml } =
                             await modeler.saveXML({
                                 format: true
                             });
         
                         localStorage.setItem(
                             STORAGE_KEY,
                             xml
                         );
         
                         updateStatus(
                             "Auto Saved"
                         );
         
                     } catch (err) {
         
                         console.error(err);
                     }
                 }
             );
         }
         
         /*
          * ---------------------------------------------------------
          * UI EVENTS
          * ---------------------------------------------------------
          */
         
         function bindUIEvents() {
         
             document
                 .getElementById(
                     "newDiagramBtn"
                 )
                 .addEventListener(
                     "click",
                     createNewDiagram
                 );
         
             document
                 .getElementById(
                     "saveBtn"
                 )
                 .addEventListener(
                     "click",
                     saveDiagram
                 );
         
             document
                 .getElementById(
                     "downloadBtn"
                 )
                 .addEventListener(
                     "click",
                     downloadDiagram
                 );
         
             document
                 .getElementById(
                     "uploadBtn"
                 )
                 .addEventListener(
                     "click",
                     openDiagram
                 );
         
             document
                 .getElementById(
                     "zoomInBtn"
                 )
                 .addEventListener(
                     "click",
                     zoomIn
                 );
         
             document
                 .getElementById(
                     "zoomOutBtn"
                 )
                 .addEventListener(
                     "click",
                     zoomOut
                 );
         
             document
                 .getElementById(
                     "fitBtn"
                 )
                 .addEventListener(
                     "click",
                     fitDiagram
                 );
         
             document
                 .getElementById(
                     "fileInput"
                 )
                 .addEventListener(
                     "change",
                     handleFileSelect
                 );
         }
         
         /*
          * ---------------------------------------------------------
          * KEYBOARD SHORTCUTS
          * ---------------------------------------------------------
          */
         
         document.addEventListener(
             "keydown",
             async function(e) {
         
                 if (!modeler) {
                     return;
                 }
         
                 /*
                  * CTRL + S
                  */
                 if (
                     e.ctrlKey &&
                     e.key === "s"
                 ) {
         
                     e.preventDefault();
         
                     await saveDiagram();
                 }
         
                 /*
                  * CTRL + O
                  */
                 if (
                     e.ctrlKey &&
                     e.key === "o"
                 ) {
         
                     e.preventDefault();
         
                     openDiagram();
                 }
             }
         );
         
         /*
          * ---------------------------------------------------------
          * START APPLICATION
          * ---------------------------------------------------------
          */
         
         window.addEventListener(
             "load",
             async function() {
         
                 try {
         
                     await initializeModeler();
         
                     registerEvents();
         
                     bindUIEvents();
                     document
                     .getElementById(
                         "addVariableBtn"
                     )
                     .addEventListener(
                         "click",
                         function() {
         
                             const selected =
                                 modeler
                                 .get("selection")
                                 .get()[0];
         
                             if (!selected) {
                                 return;
                             }
         
                             addVariable(
                                 selected
                             );
         
                             renderVariables(
                                 selected
                             );
                         }
                     );
         
                     const existingXml =
                         localStorage.getItem(
                             STORAGE_KEY
                         );
         
                     if (
                         existingXml &&
                         existingXml.trim() !== ""
                     ) {
         
                         await loadDiagram(
                             existingXml,
                             "Existing BPMN Loaded"
                         );
         
                     } else {
         
                         await createNewDiagram();
                         const rootElement =
                                 modeler
                                 .get("canvas")
                                 .getRootElement();
         
                             renderProcessVariables(
                                 rootElement
                             );
                             renderProcessConfig(
                                 rootElement
                             );
                     }
         
                 } catch (err) {
         
                     console.error(err);
         
                     updateStatus(
                         "Startup Failed"
                     );
                 }
             }
         );
         
         function buildFormOptions(
         selectedValue
         ) {
         
         let html = "";
         
         FORM_OPTIONS.forEach(function(form) {
         
             html +=
         
                 '<option value="' +
         
                 form.id +
         
                 '"' +
         
                 (form.id === selectedValue
                     ? ' selected'
                     : '') +
         
                 '>' +
         
                 form.name +
         
                 '</option>';
         });
         
         return html;
         }
         function buildOptions(
         options,
         selectedValue
         ) {
         
         let html = "";
         
         options.forEach(function(item) {
         
             html +=
         
                 '<option value="' +
         
                 item.id +
         
                 '"' +
         
                 (item.id === selectedValue
                     ? ' selected'
                     : '') +
         
                 '>' +
         
                 item.name +
         
                 '</option>';
         
         });
         
         return html;
         }
         
         function renderJqProperties(
         element
         ) {
         
         const elementName =
         element.businessObject.name || "";
         
         
         
         const container =
             document.getElementById(
                 "jqFormContainer"
             );
         
         if (
             !element ||
             element.type !== "bpmn:UserTask"
         ) {
         
             container.innerHTML =
                 "Select a User Task";
         
             return;
         }
         
         const taskConfig =
         getTaskConfig(element);
         
         
         const sla =
         getSla(
             element
         );
         
         const durationHours =
         sla?.durationHours || "";
         
         const reminderHours =
         sla?.reminderHours || "";
         
         const escalationRole =
         sla?.escalationRole || "";
         
         const autoAction =
         sla?.autoAction || "";
         
         const taskCode =
         taskConfig?.taskCode || "";
         
         const taskType =
         taskConfig?.taskType || "";
         
         const formId =
         taskConfig?.formId || "";
         
         const assigneeType =
         taskConfig?.assigneeType || "";
         
         const assigneeValue =
         taskConfig?.assigneeValue || "";
         
         const slaHours =
         taskConfig?.slaHours || "";
         
         const canReassign =
         taskConfig?.canReassign || false;
         
         const canDelegate =
         taskConfig?.canDelegate || false;
         
         let assigneeOptions = [];
         
         if (
         assigneeType === "ROLE"
         ) {
         
         assigneeOptions =
             ROLE_OPTIONS;
         }
         else if (
         assigneeType === "USER"
         ) {
         
         assigneeOptions =
             USER_OPTIONS;
         }
         else if (
         assigneeType === "GROUP"
         ) {
         
         assigneeOptions =
             GROUP_OPTIONS;
         }
         container.innerHTML =
         '<div class="jq-field">' +
         
         '<label>Element Name</label>' +
         
         '<input type="text" ' +
         
         'id="elementName" ' +
         
         'value="' +
         
         elementName +
         
         '">' +
         
         '</div>' +
         
         '<div class="jq-field">' +
         
         '<label>Task Code</label>' +
         
         '<input type="text" ' +
         'id="taskCode" ' +
         'value="' +
         taskCode +
         '">' +
         
         '</div>' +
         
         '<div class="jq-field">' +
         
         '<label>Task Type</label>' +
         
         '<select id="taskType">' +
         
             '<option value="">Select</option>' +
         
             '<option value="APPROVAL"' +
                 (taskType === "APPROVAL" ? " selected" : "") +
             '>Approval</option>' +
         
             '<option value="REVIEW"' +
                 (taskType === "REVIEW" ? " selected" : "") +
             '>Review</option>' +
         
             '<option value="DATA_ENTRY"' +
                 (taskType === "DATA_ENTRY" ? " selected" : "") +
             '>Data Entry</option>' +
         
             '<option value="NOTIFICATION"' +
                 (taskType === "NOTIFICATION" ? " selected" : "") +
             '>Notification</option>' +
         
         '</select>' +
         
         '</div>' +
         
         '<div class="jq-field">' +
         
         '<label>Form</label>' +
         
         '<select id="formId">' +
         
             '<option value="">Select Form</option>' +
         
             buildFormOptions(
                 formId
             ) +
         
         '</select>' +
         
         '</div>' +
         
         '<div class="jq-field">' +
             '<label>Assignee Type</label>' +
            '<select id="assigneeType">' +
         
         '<option value="">Select</option>' +
         
         '<option value="USER"' +
             (assigneeType === "USER" ? " selected" : "") +
         '>User</option>' +
         
         '<option value="ROLE"' +
             (assigneeType === "ROLE" ? " selected" : "") +
         '>Role</option>' +
         
         '<option value="GROUP"' +
             (assigneeType === "GROUP" ? " selected" : "") +
         '>Group</option>' +
         
         '</select>' +
         '</div>' +
         
         '<div class="jq-field">' +
         
         '<label>Assignee Value</label>' +
         
         '<select id="assigneeValue">' +
         
             '<option value="">Select</option>' +
         
             buildOptions(
                 assigneeOptions,
                 assigneeValue
             ) +
         
         '</select>' +
         
         '</div>' +
         
         '<div class="jq-field">' +
             '<label>SLA Hours</label>' +
             '<input type="number" id="slaHours" value="' +
             slaHours +
             '">' +
         '</div>' +
         
         '<div class="jq-field">' +
             '<label>Can Reassign</label>' +
             '<input type="checkbox" id="canReassign" ' +
             (canReassign ? 'checked' : '') +
             '>' +
         '</div>' +
         
         '<div class="jq-field">' +
             '<label>Can Delegate</label>' +
             '<input type="checkbox" id="canDelegate" ' +
             (canDelegate ? 'checked' : '') +
             '>' +
         '</div>' +
         
         '<hr>' +
         '<div class="jq-section">'+
         
         '<div class="jq-title">'+
         'Actions'+
         '</div>'+
         
         '<button class="jq-btn" id="addActionBtn">'+
         'Add Action'+
         '</button>'+
         
         '<div id="actionContainer"></div>'+
         
         '</div>'+
         '<hr>' +
         
         '<h3>Permissions</h3>' +
         
         '<button id="addPermissionBtn">' +
         'Add Permission' +
         '</button>' +
         
         '<div id="permissionContainer">' +
         '</div>'+
         '<hr>' +
         
         '<h3>Notifications</h3>' +
         
         '<button id="addNotificationBtn">' +
         
         'Add Notification' +
         
         '</button>' +
         
         '<div id="notificationContainer">' +
         
         '</div>'+
         '<hr>' +
         
         '<h3>SLA</h3>' +
         
         '<div class="jq-field">' +
         
         '<label>SLA Hours</label>' +
         
         '<input type="number" id="slaDuration">' +
         
         '</div>' +
         
         '<div class="jq-field">' +
         
         '<label>Reminder Hours</label>' +
         
         '<input type="number" id="slaReminder">' +
         
         '</div>' +
         
         '<div class="jq-field">' +
         
         '<label>Escalation Role</label>' +
         
         '<input type="text" id="slaEscalationRole">' +
         
         '</div>' +
         
         '<div class="jq-field">' +
         
         '<label>Auto Action</label>' +
         
         '<select id="slaAutoAction">' +
         
         '<option value="">None</option>' +
         
         '<option value="APPROVE">Approve</option>' +
         
         '<option value="REJECT">Reject</option>' +
         
         '</select>' +
         
         '</div>'+
         
         '<hr>' +
         
         '<h3>Escalations</h3>' +
         
         '<button id="addEscalationBtn">' +
         'Add Escalation' +
         '</button>' +
         
         '<div id="escalationContainer">' +
         '</div>'+
         '<hr>' +
         
         '<h3>Data Mappings</h3>' +
         
         '<button id="addDataMappingBtn">' +
         'Add Mapping' +
         '</button>' +
         
         '<div id="dataMappingContainer">' +
         '</div>' +
         '<hr>' +
         
         '<h3>Business Rule</h3>' +
         
         '<div class="jq-field">' +
         
         '<label>Rule Code</label>' +
         
         '<input type="text" ' +
         'id="ruleCode">' +
         
         '</div>' +
         
         '<div class="jq-field">' +
         
         '<label>Rule Type</label>' +
         
         '<select id="ruleType">' +
         
             '<option value="JAVA">JAVA</option>' +
         
             '<option value="SCRIPT">SCRIPT</option>' +
         
             '<option value="REST">REST</option>' +
         
         '</select>' +
         
         '</div>' +
         
         '<div class="jq-field">' +
         
         '<label>Description</label>' +
         
         '<input type="text" ' +
         'id="ruleDescription">' +
         
         '</div>'+
         '<hr>' +
         
         '<h3>Form Configuration</h3>' +
         
         '<div class="jq-field">' +
         
         '<label>Form Id</label>' +
         
         '<input type="text" id="workflowFormId">' +
         
         '</div>' +
         
         '<div class="jq-field">' +
         
         '<label>Mode</label>' +
         
         '<select id="formMode">' +
         
             '<option value="VIEW">VIEW</option>' +
         
             '<option value="EDIT">EDIT</option>' +
         
         '</select>' +
         
         '</div>' +
         
         '<div class="jq-field">' +
         
         '<label>Allow Draft</label>' +
         
         '<input type="checkbox" id="saveDraft">' +
         
         '</div>';
         const formConfig =
         getFormConfig(
             element
         );
         
         document
         .getElementById(
         "workflowFormId"
         )
         .value =
         formConfig?.formId || "";
         
         document
         .getElementById(
         "formMode"
         )
         .value =
         formConfig?.mode || "EDIT";
         
         document
         .getElementById(
         "saveDraft"
         )
         .checked =
         formConfig?.saveDraft === "true";
         
         const businessRule =
         getBusinessRule(
             element
         );
         
         document
         .getElementById(
         "ruleCode"
         )
         .value =
         businessRule?.ruleCode || "";
         
         document
         .getElementById(
         "ruleType"
         )
         .value =
         businessRule?.ruleType || "JAVA";
         
         document
         .getElementById(
         "ruleDescription"
         )
         .value =
         businessRule?.description || "";
         
         
         
         document
         .getElementById("elementName")
         .addEventListener(
             "change",
             function(e) {
         
                 saveElementName(
                     element,
                     e.target.value
                 );
             }
         );
         
         document
         .getElementById("taskCode")
         .addEventListener(
         "change",
         function(e) {
         
             saveTaskProperty(
                 element,
                 "taskCode",
                 e.target.value
             );
         }
         );
         
