         '<div class="jq-field">' +
         
             '<label>Active</label>' +
         
             '<select id="isActive">' +
         
                 '<option value="true"' +
         
                     (isActive === true ||
                      isActive === "true"
                         ? ' selected'
                         : '') +
         
                 '>Active</option>' +
         
                 '<option value="false"' +
         
                     (isActive === false ||
                      isActive === "false"
                         ? ' selected'
                         : '') +
         
                 '>Inactive</option>' +
         
             '</select>' +
         
         '</div>';
         
