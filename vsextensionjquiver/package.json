{
  "name": "jquiver-extension",
  "displayName": "JQuiver Extension",
  "publisher": "JQuiver",
  "description": "JQuiver is a low-code development framework that helps developers build enterprise applications faster using reusable components, dynamic APIs, forms, grids, dashboards, and configuration-driven development.",
  "version": "0.0.5",
  "icon": "images/jquiver-icon.png",
  "engines": {
    "vscode": "^1.115.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "*"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "jquiver.fetchApi",
        "title": "JQuiver: Fetch Data"
      },
      {
      "command": "jquiver.reloadWorkspace",
      "title": "Reload JQuiver Workspace"
      }
    ],
    "views": {
      "explorer": []
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/node-fetch": "^2.6.13",
    "@types/vscode": "^1.115.0",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^9.39.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1"
  },
  "dependencies": {
    "node-fetch": "^3.3.2"
  }
}
